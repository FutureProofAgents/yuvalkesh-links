<script is:inline>
  // copy buttons
  document.querySelectorAll('.prompt .copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var block = btn.closest('.prompt');
      var clone = block.cloneNode(true);
      clone.querySelectorAll('.lbl, .copy').forEach(function (el) { el.remove(); });
      var text = clone.innerText.trim();
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = 'הועתק ✓';
        btn.classList.add('done');
        setTimeout(function () { btn.textContent = 'העתק'; btn.classList.remove('done'); }, 1600);
      });
    });
  });

  // persistent homework checkboxes
  var KEY = 'shenkar2-hw';
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
  document.querySelectorAll('.hw input[data-hw]').forEach(function (box) {
    var id = box.getAttribute('data-hw');
    if (saved[id]) box.checked = true;
    box.addEventListener('change', function () {
      saved[id] = box.checked;
      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {}
    });
  });
</script>
</body>
