---
import LocalFonts from '../../components/LocalFonts.astro';
import pages from '../../data/project-pages.json';
import '../../styles/project-pages.css';
const site = 'https://futureproofagents.com';
const canonical = `${site}/pages/`;
const title = 'AI Workflow Projects for Your Business | FutureProof Agents';
const description = 'Explore focused AI implementation projects for construction, accounting, real estate law and executive search. Start with one workflow and clear human review.';
const booking = 'https://calendar.app.google/uWpM7vrcaS4JAZTQ6';
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'CollectionPage', name: title, description, url: canonical, inLanguage: 'en-US', mainEntity: { '@type': 'ItemList', itemListElement: pages.map((page, i) => ({ '@type': 'ListItem', position: i + 1, name: page.topic, url: `${canonical}${page.slug}/` })) } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` }, { '@type': 'ListItem', position: 2, name: 'AI projects', item: canonical }] },
] };
---
<!doctype html>
<html lang="en" dir="ltr"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="FutureProof Agents" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="en_US" /><meta property="og:image" content={`${site}/yuval-keshtcher.jpg`} /><meta property="og:image:alt" content="Yuval Keshtcher, founder of FutureProof Agents" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${site}/yuval-keshtcher.jpg`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><LocalFonts primary="inter" />
  <script is:inline src="/scripts/analytics.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</head><body class="project-site project-hub">
  <a class="project-skip" href="#main">Skip to content</a>
  <header class="project-header project-wrap"><a class="project-brand" href="/" aria-label="FutureProof Agents home"><img src="/favicon.svg" alt="" width="34" height="34" /><span>FutureProof <b>Agents</b></span></a><nav aria-label="Main navigation"><a href="/">About FutureProof</a><a class="project-button project-button-small" href={booking}>Let’s talk <span aria-hidden="true">↗</span></a></nav></header>
  <main id="main">
    <section class="project-hub-hero project-wrap" aria-labelledby="hub-title"><p class="project-kicker"><span class="project-dot" aria-hidden="true"></span>FOCUSED AI IMPLEMENTATION</p><h1 id="hub-title">Start with the work.<br /><em>Build what moves it.</em></h1><div><p class="project-lead">Practical AI projects for the documents, client information and decisions your team works with every day.</p><p>Choose a workflow. Explore what a focused first project could include, how we connect your tools and where your people stay in control.</p></div></section>
    <section class="project-hub-projects project-wrap" aria-label="AI implementation projects">{pages.map((page, i) => <a class="project-hub-row" href={`/pages/${page.slug}/`}><span class="project-hub-number">{String(i + 1).padStart(2, '0')}</span><div><p class="project-kicker">{page.topic}</p><h2>{page.title}</h2></div><div class="project-hub-row-detail"><p>{page.description}</p><span>Explore this project <span aria-hidden="true">↗</span></span></div></a>)}</section>
    <section class="project-hub-principles project-wrap" aria-label="Our approach"><div><span class="project-mono">01 / START SMALL</span><h2>One useful workflow.</h2><p>Define a concrete starting point and what your team will accept before the build.</p></div><div><span class="project-mono">02 / CONNECT THE WORK</span><h2>Your tools. An agreed scope.</h2><p>Assess access and integration options around the systems you already use.</p></div><div><span class="project-mono">03 / KEEP PEOPLE IN CONTROL</span><h2>Review where it matters.</h2><p>Make sources, exceptions and approval responsibilities part of the workflow.</p></div></section>
    <section class="project-final-cta project-wrap" aria-labelledby="hub-cta-title"><p class="project-kicker">FIND YOUR FIRST PROJECT</p><h2 id="hub-cta-title">Bring the workflow<br />that keeps coming back.</h2><p>Tell us where work gets stuck, what systems you use and who does the work. We’ll discuss whether a focused implementation makes sense.</p><a class="project-button" href={booking}>Discuss your workflow <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="project-footer project-wrap"><a class="project-brand" href="/"><img src="/favicon.svg" alt="" width="25" height="25" /><span>FutureProof <b>Agents</b></span></a><nav aria-label="Footer navigation"><a href="/">Home</a><a href="/blog/">Articles</a><a href="/ai-for-accounting-firms/">AI for accounting firms</a></nav><p>© {new Date().getFullYear()} FutureProof Agents</p></footer>
</body></html>
