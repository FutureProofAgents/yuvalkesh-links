---
import LocalFonts from '../../components/LocalFonts.astro';
import pages from '../../data/project-pages.json';
import '../../styles/project-pages.css';
const site = 'https://futureproofagents.com';
const canonical = `${site}/pages/`;
const title = 'Agentic Solutions Implemented for Your Business | FutureProof Agents';
const description = 'Quotes stuck, paperwork missing, evidence scattered or client follow-ups slipping? We implement AI agents around your business, CRM and everyday tools.';
const booking = 'https://calendar.app.google/uWpM7vrcaS4JAZTQ6';
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'CollectionPage', name: title, description, url: canonical, inLanguage: 'en-US', mainEntity: { '@type': 'ItemList', itemListElement: pages.map((page, i) => ({ '@type': 'ListItem', position: i + 1, name: page.topic, url: `${canonical}${page.slug}/` })) } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` }, { '@type': 'ListItem', position: 2, name: 'AI projects', item: canonical }] },
] };
---
<!doctype html>
<html lang="en" dir="ltr"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="FutureProof Agents" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="en_US" /><meta property="og:image" content={`${site}/yuval-keshtcher.jpg`} /><meta property="og:image:alt" content="Yuval Keshtcher, founder of FutureProof Agents" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${site}/yuval-keshtcher.jpg`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><LocalFonts primary="inter" />
  <script is:inline src="/scripts/analytics.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</head><body class="project-site project-hub">
  <a class="project-skip" href="#main">Skip to content</a>
  <header class="project-header project-wrap"><a class="project-brand" href="/" aria-label="FutureProof Agents home"><img src="/favicon.svg" alt="" width="34" height="34" /><span>FutureProof <b>Agents</b></span></a><nav aria-label="Main navigation"><a href="/">About FutureProof</a><a class="project-button project-button-small" href={booking}>Let’s talk <span aria-hidden="true">↗</span></a></nav></header>
  <main id="main">
    <section class="project-hub-hero project-wrap" aria-labelledby="hub-title"><p class="project-kicker"><span class="project-dot" aria-hidden="true"></span>AGENTIC SOLUTIONS. IMPLEMENTED FOR YOUR BUSINESS.</p><h1 id="hub-title">Your team is busy.<br /><em>The work is still waiting.</em></h1><div><p class="project-lead">The quote that still hasn’t gone out. The client documents you chased again. The evidence hidden in another PDF. The follow-up that slipped behind delivery work.</p><p>We build and implement AI agents around your existing CRM, tools and team. Find the problem your business recognizes—and see how we can help you move the work forward.</p></div></section>
    <section class="project-hub-projects project-wrap" aria-label="Agentic solutions by business need">{pages.map((page, i) => <a class="project-hub-row" href={`/pages/${page.slug}/`}><div class="project-hub-image"><img src={page.image.small} width="480" height="600" alt={page.image.alt} loading="lazy" decoding="async" /><span class="project-hub-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div><div><p class="project-kicker">{page.kicker}</p><h2>{page.title}</h2></div><div class="project-hub-row-detail"><p>{page.description}</p><span>See how we can help <span aria-hidden="true">↗</span></span></div></a>)}</section>
    <section class="project-hub-principles project-wrap" aria-label="How we implement"><div><span class="project-mono">01 / YOUR BOTTLENECK</span><h2>Start with the work that gets stuck.</h2><p>We map one recurring problem and agree on a first implementation that matters to your business.</p></div><div><span class="project-mono">02 / YOUR EXISTING TOOLS</span><h2>We handle the connections.</h2><p>Your CRM, files and communication tools stay at the center. We confirm access and build the connections the work needs.</p></div><div><span class="project-mono">03 / IMPLEMENTED FOR YOU</span><h2>We build, test and train.</h2><p>We test the agents with real examples and prepare your team to use them in everyday work.</p></div></section>
    <section class="project-final-cta project-wrap" aria-labelledby="hub-cta-title"><p class="project-kicker">LET’S LOOK AT YOUR BOTTLENECK</p><h2 id="hub-cta-title">Which task keeps<br />holding your team back?</h2><p>Talk it through with Yuval. We’ll map the problem, the tools involved and a practical first step toward getting the work moving.</p><a class="project-button" href={booking}>Map your first implementation <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="project-footer project-wrap"><a class="project-brand" href="/"><img src="/favicon.svg" alt="" width="25" height="25" /><span>FutureProof <b>Agents</b></span></a><nav aria-label="Footer navigation"><a href="/">Home</a><a href="/blog/">Articles</a><a href="/ai-for-accounting-firms/">AI for accounting firms</a></nav><p>© {new Date().getFullYear()} FutureProof Agents</p></footer>
</body></html>
