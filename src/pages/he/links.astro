---
const site = Astro.site!.href.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/he/links/#person`,
      name: 'Yuval Keshtcher',
      alternateName: ['yuvkesh', 'יובל קשטכר', 'Yuval Kesh'],
      url: `${site}/he/links/`,
      image: `${site}/avatar.jpg`,
      jobTitle: 'AI Agent Developer & Educator',
      description: 'בונה סוכני בינה מלאכותית. מלמד אנשים לבנות.',
      sameAs: [
        'https://x.com/Parzival_1991',
        'https://www.facebook.com/groups/agentil',
        'https://github.com/Yuvalkesh',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/he/links/#website`,
      name: 'yuvkesh',
      url: `${site}/he/links/`,
      inLanguage: ['he', 'en'],
      publisher: { '@id': `${site}/he/links/#person` },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <script is:inline defer src="/scripts/analytics.js"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta charset="UTF-8" />
  <script is:inline>(function(){var h=location.hostname;if(h==='futureproofagents.com'||h==='localhost'||h==='127.0.0.1')return;var p=location.pathname;if(p==='/'||p==='/index.html')p='/he/links/';location.replace('https://futureproofagents.com'+p+location.search+location.hash);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>yuvkesh</title>
  <meta name="description" content="להצטרפות לקבוצה בינה מלאכותית עסקית של יובל קשטכר" />
  <link rel="canonical" href={`${site}/he/links/`} />
  <link rel="alternate" type="application/rss+xml" title="yuvkesh" href={`${site}/rss.xml`} />

  <!-- Open Graph -->
  <meta property="og:title" content="yuvkesh" />
  <meta property="og:description" content="להצטרפות לקבוצה בינה מלאכותית עסקית של יובל קשטכר" />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}/he/links/`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:inline>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --x-blue: #1d9bf0;
      --line: #2f3336;
      --muted: #71767b;
    }

    html, body { height: 100%; }

    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: #000;
      color: #e7e9ea;
      display: flex;
      justify-content: center;
      padding: 64px 18px 48px;
      overflow-x: hidden;
      position: relative;
    }

    /* subtle X-blue glow from the top, fades in */
    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.22) 0%, rgba(29,155,240,0) 70%);
      filter: blur(20px);
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      animation: glowIn 1.4s ease-out 0.2s forwards;
    }
    @keyframes glowIn { to { opacity: 1; } }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* staggered fade-up primitive */
    .fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fadeUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .avatar-wrap {
      position: relative;
      margin-bottom: 18px;
    }
    .avatar {
      width: 116px;
      height: 116px;
      border-radius: 50%;
      object-fit: cover;
      background: #16181c;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10), 0 10px 40px rgba(0,0,0,0.6);
      display: block;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .avatar:hover {
      transform: scale(1.04);
      box-shadow: 0 0 0 5px rgba(29,155,240,0.22), 0 12px 44px rgba(0,0,0,0.7);
    }

    .name {
      font-size: 23px;
      font-weight: 800;
      letter-spacing: 0.2px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .name .verified { width: 21px; height: 21px; fill: var(--x-blue); }

    .handle {
      font-size: 15px;
      color: var(--muted);
      margin-top: 2px;
      margin-bottom: 14px;
      font-weight: 500;
    }

    .bio {
      font-size: 15px;
      color: #cfd2d4;
      text-align: center;
      max-width: 380px;
      line-height: 1.55;
      margin-bottom: 32px;
    }

    .links {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .link {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 62px;
      padding: 14px 58px;
      background: #16181c;
      color: #e7e9ea;
      border: 1px solid var(--line);
      border-radius: 999px;
      text-decoration: none;
      font-size: 16.5px;
      font-weight: 700;
      text-align: center;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      overflow: hidden;
    }
    .link::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.06), transparent 60%);
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }
    .link:hover {
      transform: translateY(-2px);
      background: #1d1f23;
      border-color: #3d4044;
      box-shadow: 0 8px 26px rgba(0,0,0,0.55);
    }
    .link:hover::after { opacity: 1; }
    .link:active { transform: translateY(0) scale(0.99); }

    .link .ico {
      position: absolute;
      inset-inline-start: 14px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex: none;
    }
    .link .ico svg { width: 21px; height: 21px; fill: #fff; }
    .ico-whatsapp { background: #25d366; }
    .ico-twitter  { background: #fff; }
    .ico-twitter svg { fill: #000; }
    .ico-facebook { background: #1877f2; }
    .ico-articles { background: var(--x-blue); }

    .footer {
      margin-top: 46px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .footer .brand {
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.4px;
      color: #e7e9ea;
    }
    .footer .sub { font-size: 12px; color: var(--muted); }

    @media (max-width: 420px) {
      body { padding-top: 48px; }
      .link { font-size: 15.5px; padding: 14px 54px; }
      .name { font-size: 21px; }
      .avatar { width: 104px; height: 104px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .fade, body::before { animation: none; opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <main class="container">
    <div class="avatar-wrap fade" style="animation-delay:0.05s">
      <img class="avatar" src="/avatar.jpg" alt="יובל קשטכר" />
    </div>

    <h1 class="name fade" style="animation-delay:0.15s">
      יובל קשטכר
      <svg class="verified" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .494.083.964.237 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>
    </h1>
    <div class="handle fade" style="animation-delay:0.2s">@yuvkesh</div>
    <p class="bio fade" style="animation-delay:0.25s">בונה סוכני בינה מלאכותית. מלמד אנשים לבנות. הצטרפו לקהילות 👇</p>

    <nav class="links">
      <a class="link fade" style="animation-delay:0.32s" href="/he/">
        <span class="ico ico-articles" aria-hidden="true">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </span>
        <span class="label">FutureProof Agents · ייעוץ והטמעת AI לעסקים</span>
      </a>

      <a class="link fade" style="animation-delay:0.35s" href="/he/blog/">
        <span class="ico ico-articles" aria-hidden="true">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
          </svg>
        </span>
        <span class="label">מאמרים על בינה מלאכותית עסקית</span>
      </a>

      <a class="link fade" style="animation-delay:0.45s" href="https://chat.whatsapp.com/KjeF05QrMTZ0s5ty66Ee92" target="_blank" rel="noopener noreferrer">
        <span class="ico ico-whatsapp" aria-hidden="true">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </span>
        <span class="label">להצטרפות לקבוצה בינה מלאכותית עסקית של יובל קשטכר</span>
      </a>

      <a class="link fade" style="animation-delay:0.55s" href="https://www.facebook.com/groups/agentil" target="_blank" rel="noopener noreferrer">
        <span class="ico ico-facebook" aria-hidden="true">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </span>
        <span class="label">קהילת "בינה מלאכותית עסקית" בפייסבוק</span>
      </a>

      <a class="link fade" style="animation-delay:0.65s" href="https://x.com/Parzival_1991" target="_blank" rel="noopener noreferrer">
        <span class="ico ico-twitter" aria-hidden="true">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <span class="label">עקבו אחריי בטוויטר / X</span>
      </a>
    </nav>

    <footer class="footer fade" style="animation-delay:0.75s">
      <div class="brand">yuvkesh</div>
      <div class="sub">בינה מלאכותית עסקית עם יובל קשטכר</div>
    </footer>
  </main>

  <script is:inline>
    // micro-animation: spotlight follows cursor on each button
    document.querySelectorAll('.link').forEach(function (el) {
      el.addEventListener('pointermove', function (e) {
        var r = el.getBoundingClientRect();
        el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        el.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  </script>
</body>
</html>
