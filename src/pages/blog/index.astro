---
import LocalFonts from '../../components/LocalFonts.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const site = Astro.site!.href.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Blog', 'CollectionPage'],
  name: 'FutureProof Agents',
  url: `${site}/blog/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem', position: i + 1,
      url: `${site}/blog/${post.id}/`, name: post.data.title,
    })),
  },
  inLanguage: 'en',
  description: 'Articles on business AI, AI agents, and building with new tools. By Yuval Keshtcher.',
  author: { '@type': 'Person', name: 'Yuval Keshtcher', url: site },
};
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <script is:inline defer src="/scripts/analytics.js"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta charset="UTF-8" />
  <script is:inline>(function(){var h=location.hostname;if(h==='futureproofagents.com'||h==='localhost'||h==='127.0.0.1')return;var p=location.pathname;if(p==='/'||p==='/index.html')p='/he/links/';location.replace('https://futureproofagents.com'+p+location.search+location.hash);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Articles | FutureProof Agents</title>
  <meta name="description" content="Articles on business AI, AI agents, and building with new tools. By Yuval Keshtcher." />
  <link rel="canonical" href={`${site}/blog/`} />
  <link rel="alternate" hreflang="en" href={`${site}/blog/`} />
  <link rel="alternate" hreflang="he" href={`${site}/he/blog/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/blog/`} />
  <link rel="alternate" type="application/rss+xml" title="FutureProof Agents" href={`${site}/rss.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Articles | FutureProof Agents" />
  <meta property="og:description" content="Articles on business AI, AI agents, and building with new tools. By Yuval Keshtcher." />
  <meta property="og:url" content={`${site}/blog/`} />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <LocalFonts hebrew={false} />

</head>
<body>
  <main>
    <BlogArchive posts={posts} lang="en" />
  </main>
  <SiteFooter lang="en" />
</body>
</html>
