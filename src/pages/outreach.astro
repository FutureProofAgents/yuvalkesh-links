---
const title='FutureProof Outreach';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <script is:inline>if(location.hostname==='futureproofagents.com'||location.hostname==='www.futureproofagents.com')location.replace('https://yuvalkesh-links.vercel.app/outreach/'+location.search+location.hash);</script>
  <style is:inline>
    *{box-sizing:border-box} :root{--bg:#070809;--panel:#101214;--panel2:#16191d;--line:#2a3037;--ink:#f4f7f9;--muted:#8f9aa5;--blue:#1d9bf0;--green:#37d67a;--red:#ff6678;--amber:#f4b942} body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.login{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 50% 0,rgba(29,155,240,.18),transparent 40%)}.login-card{width:min(440px,100%);padding:34px;border:1px solid var(--line);border-radius:24px;background:rgba(16,18,20,.96);box-shadow:0 30px 90px #000}.mark{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:var(--blue);color:#001522;font-weight:900;font-size:20px}.login h1{font-size:28px;margin:22px 0 8px}.login p{color:var(--muted);margin:0 0 24px}.stack{display:grid;gap:12px}.field{display:grid;gap:7px}.field span{font-size:12px;color:#b8c1ca;font-weight:700}.input{width:100%;border:1px solid var(--line);border-radius:12px;background:#0b0d0f;color:#fff;padding:12px 14px;min-height:46px;outline:none}.input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(29,155,240,.12)}textarea.input{min-height:130px;resize:vertical}.btn{border:1px solid var(--line);background:var(--panel2);color:#fff;border-radius:11px;padding:10px 14px;font-weight:750}.btn:hover{border-color:#4b5661}.btn.primary{background:var(--blue);border-color:var(--blue);color:#001522}.btn.danger{color:#ff94a0}.btn:disabled{opacity:.5;cursor:not-allowed}.shell{min-height:100vh;display:grid;grid-template-columns:230px 1fr}.sidebar{border-right:1px solid var(--line);background:#0b0d0f;padding:22px 14px;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:11px;padding:0 8px 22px;font-weight:900;font-size:16px}.brand span{color:var(--blue)}.nav{display:grid;gap:5px}.nav button{width:100%;text-align:left;border:0;background:transparent;color:var(--muted);padding:10px 12px;border-radius:9px;font-weight:720}.nav button:hover,.nav button.active{background:var(--panel2);color:#fff}.sidebar-foot{position:absolute;bottom:18px;left:14px;right:14px}.main{min-width:0}.topbar{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;background:rgba(7,8,9,.88);backdrop-filter:blur(16px);z-index:5}.topbar h1{font-size:18px;margin:0}.status{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 8px var(--green)}.content{padding:28px;max-width:1440px}.view{display:none}.view.active{display:block}.hero-row{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:24px}.hero-row h2{margin:0;font-size:26px}.hero-row p{margin:6px 0 0;color:var(--muted)}.actions{display:flex;gap:9px;flex-wrap:wrap}.metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:24px}.metric{padding:18px;border:1px solid var(--line);border-radius:15px;background:var(--panel)}.metric span{display:block;color:var(--muted);font-size:12px}.metric strong{display:block;font-size:28px;margin-top:6px}.metric em{font-style:normal;color:var(--green);font-size:11px}.panel{border:1px solid var(--line);border-radius:16px;background:var(--panel);overflow:hidden;margin-bottom:20px}.panel-head{padding:16px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:12px}.panel-head h3{margin:0;font-size:14px}.panel-body{padding:18px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.full{grid-column:1/-1}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:12px 15px;border-bottom:1px solid var(--line);vertical-align:middle}th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.7px}td{font-size:13px}.pill{display:inline-flex;padding:4px 8px;border-radius:999px;background:#20252a;color:#bdc7d0;font-size:11px}.pill.sent,.pill.delivered,.pill.opened,.pill.clicked{background:rgba(29,155,240,.12);color:#77c8ff}.pill.replied,.pill.applied{background:rgba(55,214,122,.12);color:#79e9a7}.pill.failed,.pill.bounced,.pill.complained{background:rgba(255,102,120,.12);color:#ff9aaa}.empty{padding:42px;text-align:center;color:var(--muted)}.notice{padding:12px 14px;border:1px solid #315573;border-radius:11px;background:#0c1d2a;color:#b5dcf7;margin-bottom:16px}.error{border-color:#70343d;background:#281116;color:#ffb0ba}.import-zone{border:1px dashed #3b4650;border-radius:14px;padding:26px;text-align:center;background:#0c0e10}.import-zone input{margin-top:12px}.help{color:var(--muted);font-size:12px}.toast{position:fixed;right:22px;bottom:22px;z-index:20;background:#fff;color:#111;padding:12px 16px;border-radius:10px;box-shadow:0 12px 40px #000;font-weight:700;max-width:360px}.mobile-nav{display:none}.check{width:18px;height:18px;accent-color:var(--blue)}
    @media(max-width:980px){.metrics{grid-template-columns:repeat(2,1fr)}.grid3{grid-template-columns:1fr 1fr}}
    @media(max-width:720px){.shell{display:block}.sidebar{display:none}.topbar{padding:0 18px}.content{padding:18px}.metrics,.grid2,.grid3{grid-template-columns:1fr}.hero-row{display:grid}.mobile-nav{display:flex;gap:6px;overflow:auto;padding:10px 14px;border-bottom:1px solid var(--line)}.mobile-nav button{white-space:nowrap}.full{grid-column:auto}}
  </style>
</head>
<body>
<section class="login" id="login">
  <div class="login-card">
    <div class="mark">F</div><h1>FutureProof Outreach</h1><p>Private outreach console for executive newsletter invitations.</p>
    <form class="stack" id="request-form"><label class="field"><span>Admin email</span><input class="input" type="email" name="email" value="y@uxwritinghub.com" required /></label><button class="btn primary">Email me a login code</button></form>
    <form class="stack hidden" id="verify-form"><label class="field"><span>Six-digit code</span><input class="input" inputmode="numeric" name="code" maxlength="6" pattern="[0-9]{6}" required /></label><button class="btn primary">Open console</button><button class="btn" type="button" id="back-login">Use another email</button></form>
    <p class="help" id="login-status" style="margin-top:14px"></p>
  </div>
</section>
<div class="shell hidden" id="app">
  <aside class="sidebar"><div class="brand"><div class="mark">F</div>FutureProof <span>Outreach</span></div><nav class="nav" data-nav><button class="active" data-view="dashboard">Overview</button><button data-view="campaigns">Campaigns</button><button data-view="contacts">Recipients</button><button data-view="inbox">Inbox</button><button data-view="applications">Applications</button></nav><div class="sidebar-foot"><button class="btn" id="logout" style="width:100%">Sign out</button></div></aside>
  <main class="main"><header class="topbar"><h1 id="view-title">Overview</h1><div class="status"><span class="dot"></span> integrations connected</div></header><div class="mobile-nav nav" data-nav><button class="active" data-view="dashboard">Overview</button><button data-view="campaigns">Campaigns</button><button data-view="contacts">Recipients</button><button data-view="inbox">Inbox</button><button data-view="applications">Applications</button></div>
  <div class="content">
    <section class="view active" id="view-dashboard"><div class="hero-row"><div><h2>Executive outreach, under your control.</h2><p>Every recipient requires explicit approval before an email can leave the system.</p></div><div class="actions"><button class="btn" data-refresh>Refresh</button><button class="btn primary" data-go="campaigns">Create campaign</button></div></div><div class="metrics" id="metrics"></div><div class="panel"><div class="panel-head"><h3>Recent recipients</h3></div><div id="recent"></div></div></section>
    <section class="view" id="view-campaigns"><div class="hero-row"><div><h2>Campaigns</h2><p>Draft the invitation and follow-up before importing recipients.</p></div></div><div class="panel"><div class="panel-head"><h3>New campaign</h3></div><form class="panel-body grid2" id="campaign-form"><label class="field"><span>Campaign name</span><input class="input" name="name" required placeholder="September CEO invitations" /></label><label class="field"><span>Language</span><select class="input" name="language"><option>English</option><option>Hebrew</option></select></label><label class="field"><span>Sender name</span><input class="input" name="senderName" value="Yuval Keshtcher" required /></label><label class="field"><span>Verified sender email</span><input class="input" type="email" name="senderEmail" placeholder="yuval@futureproofagents.com" required /></label><label class="field"><span>Reply-to inbox</span><input class="input" type="email" name="replyTo" value="y@uxwritinghub.com" required /></label><label class="field"><span>Follow-up after days</span><input class="input" type="number" name="followupDays" value="4" min="1" max="30" /></label><label class="field full"><span>Subject — supports &#123;&#123;first_name&#125;&#125;, &#123;&#123;company&#125;&#125;</span><input class="input" name="subject" required placeholder="A private AI briefing for &#123;&#123;first_name&#125;&#125;" /></label><label class="field full"><span>Invitation body</span><textarea class="input" name="body" required placeholder="Hi &#123;&#123;first_name&#125;&#125;,&#10;&#10;I’m inviting a small group of senior executives..."></textarea></label><label class="field full"><span>Follow-up subject</span><input class="input" name="followupSubject" placeholder="Re: FutureProof" /></label><label class="field full"><span>Follow-up body</span><textarea class="input" name="followupBody" placeholder="Hi &#123;&#123;first_name&#125;&#125;, a quick follow-up..."></textarea></label><div class="full"><button class="btn primary">Save draft campaign</button></div></form></div><div class="panel"><div class="panel-head"><h3>Saved campaigns</h3></div><div id="campaign-list"></div></div></section>
    <section class="view" id="view-contacts"><div class="hero-row"><div><h2>Recipients</h2><p>Import CSV, review every person, approve, then send one by one.</p></div><button class="btn" data-refresh>Refresh</button></div><div class="panel"><div class="panel-head"><h3>Import CSV</h3></div><div class="panel-body"><div class="grid2"><label class="field"><span>Campaign</span><select class="input" id="import-campaign"></select></label><div class="import-zone"><strong>Choose a CSV file</strong><div class="help">Columns: email, firstName, fullName, jobTitle, company, language, personalNote</div><input type="file" id="csv-file" accept=".csv,text/csv" /></div></div><div style="margin-top:14px"><button class="btn primary" id="import-btn" disabled>Import reviewed contacts</button></div></div></div><div class="panel"><div class="panel-head"><h3>Recipient queue</h3><span class="help">Sending is never automatic</span></div><div id="recipient-list"></div></div></section>
    <section class="view" id="view-inbox"><div class="hero-row"><div><h2>Inbox</h2><p>Match recent Gmail replies to outreach recipients.</p></div><button class="btn primary" id="sync-inbox">Sync replies now</button></div><div class="notice">Replies are read from the connected inbox only when you press Sync. Raw mailbox contents are not stored in this console.</div><div class="panel"><div class="panel-head"><h3>Matched conversations</h3></div><div id="inbox-list"></div></div></section>
    <section class="view" id="view-applications"><div class="hero-row"><div><h2>Newsletter applications</h2><p>Applicants from FutureProof are shown alongside outreach status.</p></div><button class="btn" data-refresh>Refresh</button></div><div class="panel"><div class="panel-head"><h3>Application review</h3></div><div id="application-list"></div></div></section>
  </div></main>
</div><div class="toast hidden" id="toast"></div>
<script is:inline>
(function(){
const api='/api/outreach';let state={campaigns:[],recipients:[],applications:[],counts:{}};const $=(q)=>document.querySelector(q);const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function call(action,method='GET',body){const r=await fetch(`${api}?action=${encodeURIComponent(action)}`,{method,headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined,credentials:'same-origin'});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}
function toast(msg,bad=false){const n=$('#toast');n.textContent=msg;n.style.background=bad?'#ff6678':'#fff';n.classList.remove('hidden');setTimeout(()=>n.classList.add('hidden'),3200)}
function showApp(){ $('#login').classList.add('hidden');$('#app').classList.remove('hidden');refresh() }
async function refresh(){try{const d=await call('dashboard');state=d;render()}catch(e){if(e.message.includes('Authentication'))location.reload();else toast(e.message,true)}}
function table(headers,rows){if(!rows.length)return '<div class="empty">Nothing here yet.</div>';return `<div class="table-wrap"><table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`}
function campaignName(ids){return state.campaigns.find(c=>ids?.includes(c.id))?.fields?.['Campaign Name']||'—'}
function render(){const c=state.counts||{};$('#metrics').innerHTML=[['Recipients',c.total||0],['Approved',c.approved||0],['Sent',c.sent||0],['Replies',c.replied||0],['Applied',c.applied||0]].map(([l,v])=>`<div class="metric"><span>${l}</span><strong>${v}</strong><em>live Airtable data</em></div>`).join('');
 const recipientRows=state.recipients.map(r=>{const f=r.fields||{};return `<tr><td><strong>${esc(f['Full Name']||f['First Name']||'—')}</strong><br><span class="help">${esc(f.Email)}</span></td><td>${esc(f.Company||'—')}</td><td>${esc(campaignName(f.Campaign))}</td><td><span class="pill ${esc(f.Status)}">${esc(f.Status||'imported')}</span></td><td><label><input class="check approve" data-id="${r.id}" type="checkbox" ${f['Sequence Approved']?'checked':''}> sequence</label></td><td><button class="btn primary send" data-id="${r.id}" ${f.Status==='approved'?'':'disabled'}>Send</button></td></tr>`}).join('');
 $('#recipient-list').innerHTML=table(['Person','Company','Campaign','Status','Approval','Action'],recipientRows);$('#recent').innerHTML=table(['Person','Company','Status'],state.recipients.slice(-8).reverse().map(r=>`<tr><td>${esc(r.fields?.['Full Name']||r.fields?.Email)}</td><td>${esc(r.fields?.Company||'—')}</td><td><span class="pill ${esc(r.fields?.Status)}">${esc(r.fields?.Status||'imported')}</span></td></tr>`));
 $('#campaign-list').innerHTML=table(['Campaign','Language','Subject','Status'],state.campaigns.map(r=>`<tr><td><strong>${esc(r.fields?.['Campaign Name'])}</strong></td><td>${esc(r.fields?.Language)}</td><td>${esc(r.fields?.Subject)}</td><td><span class="pill">${esc(r.fields?.Status||'draft')}</span></td></tr>`));
 $('#import-campaign').innerHTML='<option value="">Choose campaign</option>'+state.campaigns.map(r=>`<option value="${r.id}">${esc(r.fields?.['Campaign Name'])}</option>`).join('');
 const replies=state.recipients.filter(r=>r.fields?.Status==='replied');$('#inbox-list').innerHTML=table(['Executive','Company','Reply status','Thread'],replies.map(r=>`<tr><td>${esc(r.fields?.['Full Name']||r.fields?.Email)}</td><td>${esc(r.fields?.Company||'—')}</td><td><span class="pill replied">reply matched</span></td><td>${r.fields?.['Gmail Thread ID']?'<span class="help">Recorded</span>':'—'}</td></tr>`));
 $('#application-list').innerHTML=table(['Applicant','Role','Company','Review'],state.applications.slice().reverse().map(r=>`<tr><td><strong>${esc(r.fields?.['Full Name']||'—')}</strong><br><span class="help">${esc(r.fields?.Email)}</span></td><td>${esc(r.fields?.['Job Title']||'—')}</td><td>${esc(r.fields?.Organization||'—')}</td><td><span class="pill ${esc(r.fields?.['Review Status'])}">${esc(r.fields?.['Review Status']||'pending')}</span></td></tr>`));bindRows();}
function bindRows(){document.querySelectorAll('.approve').forEach(x=>x.onchange=async()=>{x.disabled=true;try{await call('approve-recipient','POST',{id:x.dataset.id,approved:x.checked});toast(x.checked?'Recipient approved':'Approval removed');await refresh()}catch(e){toast(e.message,true);x.checked=!x.checked}finally{x.disabled=false}});document.querySelectorAll('.send').forEach(x=>x.onclick=async()=>{if(!confirm('Send this invitation now?'))return;x.disabled=true;try{await call('send-recipient','POST',{id:x.dataset.id});toast('Invitation sent');await refresh()}catch(e){toast(e.message,true)}finally{x.disabled=false}})}
$('#request-form').onsubmit=async e=>{e.preventDefault();const b=e.submitter;b.disabled=true;try{await call('request-login','POST',{email:new FormData(e.target).get('email')});$('#request-form').classList.add('hidden');$('#verify-form').classList.remove('hidden');$('#login-status').textContent='A one-time code was sent to the admin inbox.'}catch(x){$('#login-status').textContent=x.message}finally{b.disabled=false}};
$('#verify-form').onsubmit=async e=>{e.preventDefault();const b=e.submitter;b.disabled=true;try{await call('verify-login','POST',{code:new FormData(e.target).get('code')});showApp()}catch(x){$('#login-status').textContent=x.message}finally{b.disabled=false}};$('#back-login').onclick=()=>{$('#verify-form').classList.add('hidden');$('#request-form').classList.remove('hidden')};
$('#logout').onclick=async()=>{await call('logout','POST',{});location.reload()};document.querySelectorAll('[data-nav] button').forEach(b=>b.onclick=()=>go(b.dataset.view));document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>go(b.dataset.go));function go(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===`view-${v}`));document.querySelectorAll('[data-nav] button').forEach(x=>x.classList.toggle('active',x.dataset.view===v));$('#view-title').textContent=({dashboard:'Overview',campaigns:'Campaigns',contacts:'Recipients',inbox:'Inbox',applications:'Applications'})[v]}
document.querySelectorAll('[data-refresh]').forEach(b=>b.onclick=refresh);$('#campaign-form').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));const b=e.submitter;b.disabled=true;try{await call('create-campaign','POST',data);e.target.reset();toast('Draft campaign saved');await refresh()}catch(x){toast(x.message,true)}finally{b.disabled=false}};
let csv=[];$('#csv-file').onchange=async e=>{const text=await e.target.files[0]?.text();if(!text)return;csv=parseCSV(text);$('#import-btn').disabled=!csv.length;toast(`${csv.length} valid rows ready for review`)};function parseCSV(text){const lines=[];let row=[],cell='',quote=false;for(let i=0;i<text.length;i++){const ch=text[i],next=text[i+1];if(ch==='"'&&quote&&next==='"'){cell+='"';i++}else if(ch==='"')quote=!quote;else if(ch===','&&!quote){row.push(cell);cell=''}else if((ch==='\n'||ch==='\r')&&!quote){if(ch==='\r'&&next==='\n')i++;row.push(cell);if(row.some(Boolean))lines.push(row);row=[];cell=''}else cell+=ch}row.push(cell);if(row.some(Boolean))lines.push(row);if(lines.length<2)return[];const keys=lines[0].map(x=>x.trim().replace(/^\ufeff/,'').toLowerCase().replace(/[ _-]/g,''));const aliases={email:'email',firstname:'firstName',name:'fullName',fullname:'fullName',title:'jobTitle',jobtitle:'jobTitle',company:'company',organization:'company',language:'language',personalnote:'personalNote',note:'personalNote'};return lines.slice(1).map(cols=>Object.fromEntries(cols.map((v,i)=>[aliases[keys[i]]||keys[i],v.trim()]))).filter(x=>x.email)}
$('#import-btn').onclick=async e=>{const campaignId=$('#import-campaign').value;if(!campaignId)return toast('Choose a campaign',true);e.target.disabled=true;try{const d=await call('import-recipients','POST',{campaignId,contacts:csv});toast(`${d.imported} imported, ${d.skipped} skipped`);$('#csv-file').value='';csv=[];await refresh()}catch(x){toast(x.message,true)}finally{e.target.disabled=false}};$('#sync-inbox').onclick=async e=>{e.target.disabled=true;try{const d=await call('sync-inbox','POST',{});toast(`${d.matched} replies matched`);await refresh()}catch(x){toast(x.message,true)}finally{e.target.disabled=false}};
call('session').then(showApp).catch(()=>{});
})();
</script>
</body></html>
