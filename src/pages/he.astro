---
import SiteFooter from '../components/SiteFooter.astro';
const site = Astro.site!.href.replace(/\/$/, '');

const waMsg = encodeURIComponent('היי יובל, ראיתי את העמוד של FutureProof Agents ואשמח לדבר על AI לעסק שלי');
const waLink = `https://wa.me/972526414555?text=${waMsg}`;
const loopYouTube = 'https://www.youtube.com/@theLOOP-tube';

const hats = [
  {
    icon: '📦',
    title: 'מוצר ושירות',
    desc: 'סוכנים מול לקוחות, מערכות שירות ופתרונות שמשפרים את החוויה ואת המוצר עצמו.',
  },
  {
    icon: '📣',
    title: 'שיווק',
    desc: 'מנועי תוכן, מערכות אורגניות וממומנות, הפריצות שמביאות תנועה. התחום החזק שלנו.',
  },
  {
    icon: '🎯',
    title: 'מכירות',
    desc: 'תהליכי מכירה, CRM, ניתוח שיחות, מאמני מכירות AI ומערכות מודיעין מבוססות סיגנלים.',
  },
  {
    icon: '⚙️',
    title: 'תפעול',
    desc: 'אוטומציה לעבודה ידנית. חיובים, חשבוניות, דוחות ותהליכים שמפוזרים על אקסלים.',
  },
];

const cases = [
  {
    name: 'JVP',
    tag: 'קרן הון סיכון',
    built: 'בנינו לצוות ה-IR של הקרן סוכן שמייצר אוטומטית מסמך תדרוך מלא על משקיע (LP). הסוכן אוסף מה-CRM, מהרשת ומלינקדאין, מצליב הכול, מצרף ציטוטים ומקורות, ומוציא מסמך מוכן בפורמט של הקרן.',
    outcome: 'דוח שלקח שעות עבודה ידנית נבנה עכשיו בכחמש דקות, עם דיוק עובדתי של 95% ומעלה. הפרויקט הוצג לשותפי הקרן, כולל היו״ר אראל מרגלית, וקיבל אור ירוק להרחבה.',
    quote: 'this to me feels like you\'ve figured it out. It looks great.',
    who: 'Lauren Kiel, Investor Relations, JVP',
  },
  {
    name: 'Ginger Insurance',
    tag: 'אינשורטק',
    built: 'בנינו סוכן AI מול לקוחות הקצה שלא רק עונה על שאלות אלא מבצע פעולות. הוא שולח בקשה לאישור MRI במייל ללקוח ולחברה, וקובע שיחה חיה עם מנהל תיק. בנינו גם מנגנון בדיקות (eval) והטמעה מבודדת בתוך המערכת של ג\'ינג\'ר.',
    outcome: 'הסוכן עלה לאוויר ומבצע פעולות אמת בסביבת הייצור, כולל פתיחת בקשות וקביעת פגישות מול הלקוח.',
    quote: 'וואו. זה מדהים. זה מדהים.',
    who: 'אושרת בן משה, מנכ״לית ומייסדת, Ginger',
  },
  {
    name: 'iPracticom',
    tag: 'חברת תקשורת',
    built: 'בנינו "מוח שיווקי" מבוסס ארבע מיומנויות (קריאייטיב ← תוכן ← תזמון ← ניטור) על ארכיטקטורת ויקי, שנועד להחליף סוכנות שיווק חיצונית. המערכת מייצרת פוסטים וגרפיקות חיות.',
    outcome: 'המערכת עובדת ומפיקה פוסטים בפועל, והמנכ״ל ביקש להרחיב אותה למוח ארגוני רוחבי לכל החברה, שישרת גם את מערך השירות.',
    quote: null,
    who: null,
  },
];

const team = [
  {
    hue: '#22c55e',
    role: 'CTO · ראש הפיתוח',
    desc: 'מוביל את הפיתוח בכל פרויקט, ומפקד על צי הסוכנים שלמטה ועל שני מהנדסים אנושיים שבודקים, מחשלים ומשחררים.',
    fleet: true,
  },
  {
    hue: '#f59e0b',
    role: 'ארכיטקטית תהליכים עסקיים',
    desc: 'עשרות שנות ניהול תפעולי בקבוצות קמעונאות, אנרגיה ובנייה מהגדולות בישראל. הופכת את הדרך שבה חברה באמת עובדת לתרשימי זרימה שאפשר לבנות עליהם מערכת.',
  },
  {
    hue: '#a78bfa',
    role: 'פיתוח מכירות (SDR)',
    desc: 'פנייה יזומה, סינון ושיחות ראשונות. שומרים על צינור מכירות בתנועה, כדי שהבונים יישארו בבנייה.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/he/#org`,
  url: `${site}/he/`,
  name: 'FutureProof Agents',
  description: 'מערכות סוכני AI מוטמעות בעסקים אמיתיים. מהאפיון ועד ההטמעה המלאה, נמדד בשורת הרווח.',
  founder: {
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: 'Yuval Keshtcher',
    alternateName: ['yuvkesh', 'יובל קשטכר'],
    url: `${site}/`,
    image: `${site}/avatar.jpg`,
    jobTitle: 'AI Consultant & Implementer',
    knowsAbout: ['Artificial Intelligence', 'AI Agents', 'Automation', 'Product', 'UX'],
    sameAs: [
      'https://x.com/Parzival_1991',
      'https://www.facebook.com/groups/agentil',
      'https://github.com/Yuvalkesh',
    ],
  },
};
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta charset="UTF-8" />
  <script is:inline>(function(){var h=location.hostname;if(h==='futureproofagents.com'||h==='localhost'||h==='127.0.0.1')return;var p=location.pathname;if(p==='/'||p==='/index.html')p='/he/links/';location.replace('https://futureproofagents.com'+p+location.search+location.hash);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>הטמעת סוכני AI ואוטומציה לעסקים | FutureProof Agents</title>
  <meta name="description" content="אפיון תהליכים עסקיים והטמעת סוכני AI בהתאמה לארגון: חיבור מערכות, בקרה אנושית ומדידת תוצאות. FutureProof Agents — מהאפיון ועד מערכת עובדת." />
  <link rel="canonical" href={`${site}/he/`} />
  <link rel="alternate" hreflang="he" href={`${site}/he/`} />
  <link rel="alternate" hreflang="en" href={`${site}/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/`} />

  <!-- Open Graph -->
  <meta property="og:title" content="FutureProof Agents — מערכות סוכני AI לעסקים אמיתיים" />
  <meta property="og:description" content="מערכות סוכני AI מוטמעות בעסקים אמיתיים. מהאפיון ועד ההטמעה המלאה, נמדד בשורת הרווח." />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}/he/`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style is:inline>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --x-blue: #1d9bf0;
      --line: #2f3336;
      --muted: #71767b;
    }

    html, body { height: 100%; }

    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: #000;
      color: #e7e9ea;
      display: flex;
      justify-content: center;
      padding: 56px 18px 64px;
      overflow-x: hidden;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.22) 0%, rgba(29,155,240,0) 70%);
      filter: blur(20px);
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      animation: glowIn 1.4s ease-out 0.2s forwards;
    }
    @keyframes glowIn { to { opacity: 1; } }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 680px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fadeUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* --- lang toggle --- */
    .lang {
      align-self: flex-end;
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 6px 14px;
      margin-bottom: 22px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .lang:hover { color: #e7e9ea; border-color: #3d4044; }

    /* --- brand hero --- */
    .brandmark {
      width: 84px;
      height: 84px;
      border-radius: 22px;
      background: #16181c;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10), 0 10px 40px rgba(0,0,0,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .brandmark svg { width: 46px; height: 46px; }
    .brand-name {
      font-size: 34px;
      font-weight: 900;
      letter-spacing: -0.5px;
      color: #fff;
      text-align: center;
      line-height: 1.15;
      direction: ltr;
    }
    .brand-name span { color: var(--x-blue); }
    .brand-sub {
      font-size: 13.5px;
      font-weight: 700;
      letter-spacing: 1px;
      color: var(--muted);
      margin-top: 10px;
      text-align: center;
    }
    .role {
      font-size: 16px;
      color: var(--x-blue);
      font-weight: 700;
      margin-top: 6px;
    }
    .lead {
      font-size: 16px;
      color: #cfd2d4;
      text-align: center;
      max-width: 500px;
      line-height: 1.7;
      margin: 16px 0 26px;
    }
    .lead b { color: #fff; font-weight: 700; }

    /* --- buttons --- */
    .cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 14px 30px;
      background: #25d366;
      color: #04210f;
      border: none;
      border-radius: 999px;
      text-decoration: none;
      font-size: 16.5px;
      font-weight: 800;
      font-family: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      box-shadow: 0 8px 26px rgba(37,211,102,0.22);
    }
    .cta svg { width: 22px; height: 22px; fill: #04210f; }
    .cta:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: 0 12px 32px rgba(37,211,102,0.3); }
    .cta:active { transform: translateY(0) scale(0.99); }
    .cta.yt {
      background: #ff0033;
      color: #fff;
      box-shadow: 0 8px 26px rgba(255,0,51,0.22);
    }
    .cta.yt svg { fill: none; stroke: #fff; stroke-width: 2; }
    .cta.yt:hover { box-shadow: 0 12px 32px rgba(255,0,51,0.3); }

    /* --- sections --- */
    section { width: 100%; }
    .divider {
      width: 100%;
      height: 1px;
      background: var(--line);
      margin: 44px 0;
      border: none;
    }
    .section-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.6px;
      text-align: center;
      margin-bottom: 24px;
    }

    /* --- logos --- */
    .logo-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 22px 40px;
    }
    .logo-strip img {
      height: 30px;
      width: auto;
      filter: grayscale(1) brightness(0) invert(1) opacity(0.6);
      transition: filter 0.25s ease;
    }
    .logo-strip img.tall { height: 38px; }
    .logo-strip img:hover { filter: grayscale(1) brightness(0) invert(1) opacity(1); }
    .logo-word {
      font-weight: 800;
      font-size: 19px;
      color: #8a9099;
      letter-spacing: 0.3px;
      white-space: nowrap;
      transition: color 0.25s ease;
    }
    .logo-word.mono { letter-spacing: 2px; font-size: 16px; }
    .logo-word:hover { color: #e7e9ea; }
    .logo-mark { display: inline-flex; align-items: center; gap: 8px; }

    /* --- four hats method --- */
    .method-head { text-align: center; margin-bottom: 26px; }
    .method-head h2 { font-size: 23px; font-weight: 800; color: #fff; line-height: 1.25; }
    .method-head .sub { font-size: 15px; color: var(--x-blue); font-weight: 700; margin-top: 6px; }
    .method-head .tag {
      font-size: 14.5px;
      color: #cfd2d4;
      line-height: 1.7;
      max-width: 440px;
      margin: 12px auto 0;
    }
    .hats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      width: 100%;
    }
    .hat {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .hat:hover { border-color: #3d4044; transform: translateY(-2px); }
    .hat .icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
      margin-bottom: 14px;
    }
    .hat h3 { font-size: 17.5px; font-weight: 800; color: #fff; margin-bottom: 7px; }
    .hat p { font-size: 14px; line-height: 1.6; color: #b8bcbf; }
    .method-foot {
      font-size: 14.5px;
      line-height: 1.7;
      color: #cfd2d4;
      text-align: center;
      max-width: 480px;
      margin: 24px auto 0;
    }
    .method-foot b { color: #fff; font-weight: 700; }

    /* --- case cards --- */
    .cases { display: flex; flex-direction: column; gap: 18px; width: 100%; }
    .case {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .case:hover { border-color: #3d4044; transform: translateY(-2px); }
    .case-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .case-name { font-size: 21px; font-weight: 800; color: #fff; }
    .case-tag {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--x-blue);
      background: rgba(29,155,240,0.12);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .case-row { margin-bottom: 14px; }
    .case-row .k {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--muted);
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }
    .case-row .v { font-size: 15px; line-height: 1.7; color: #d6d9db; }
    .quote {
      border-inline-start: 3px solid var(--x-blue);
      padding-inline-start: 14px;
      margin-top: 16px;
    }
    .quote p {
      font-size: 15.5px;
      line-height: 1.6;
      color: #e7e9ea;
      font-style: italic;
    }
    .quote .who { font-size: 13px; color: var(--muted); margin-top: 6px; font-style: normal; font-weight: 700; }

    /* --- team --- */
    .team-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      width: 100%;
    }
    .member {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
      text-align: center;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .member:hover { border-color: #3d4044; transform: translateY(-2px); }
    .member.wide { grid-column: 1 / -1; }
    .p-avatar {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      display: block;
      margin: 0 auto 14px;
    }
    .member h3 { font-size: 17px; font-weight: 800; color: #fff; margin-bottom: 7px; }
    .member p { font-size: 14px; line-height: 1.6; color: #b8bcbf; max-width: 420px; margin: 0 auto; }
    .fleet {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 18px;
    }
    .fleet .bot {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(29,155,240,0.08);
      border: 1px solid rgba(29,155,240,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .fleet .bot svg { width: 26px; height: 26px; }
    .fleet .bot.human {
      border-radius: 50%;
      background: rgba(34,197,94,0.08);
      border-color: rgba(34,197,94,0.3);
    }
    .fleet-caption {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.4px;
      margin-top: 12px;
    }
    .team-note {
      font-size: 14.5px;
      line-height: 1.7;
      color: #cfd2d4;
      text-align: center;
      max-width: 480px;
      margin: 24px auto 0;
    }
    .team-note b { color: #fff; font-weight: 700; }

    /* --- founder --- */
    .founder { text-align: center; }
    .founder .avatar {
      width: 104px;
      height: 104px;
      border-radius: 50%;
      object-fit: cover;
      background: #16181c;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10), 0 10px 40px rgba(0,0,0,0.6);
      display: block;
      margin: 0 auto 18px;
    }
    .founder .name {
      font-size: 24px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .founder .name .verified { width: 21px; height: 21px; fill: var(--x-blue); }
    .founder .lead { margin-inline: auto; }

    /* --- theLOOP --- */
    .loop { text-align: center; }
    .loop .loop-brand {
      font-size: 24px;
      font-weight: 800;
      color: #fff;
      letter-spacing: 0.3px;
      margin-bottom: 4px;
      direction: ltr;
    }
    .loop .loop-brand span { color: var(--x-blue); }
    .loop .loop-tag {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2.2px;
      color: var(--muted);
      margin-bottom: 16px;
      direction: ltr;
    }
    .loop p {
      font-size: 15px;
      color: #cfd2d4;
      line-height: 1.7;
      max-width: 480px;
      margin: 0 auto 22px;
    }
    .loop p b { color: #fff; font-weight: 700; }

    /* --- closing --- */
    .closing { text-align: center; }
    .closing h2 { font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 10px; }
    .closing p { font-size: 15px; color: #cfd2d4; line-height: 1.7; max-width: 420px; margin: 0 auto 22px; }

    .footer {
      margin-top: 48px;
      text-align: center;
    }
    .footer .brand { font-weight: 800; font-size: 14px; letter-spacing: 0.4px; color: #e7e9ea; }
    .footer .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .footer a { color: var(--muted); text-decoration: none; }
    .footer a:hover { color: var(--x-blue); }
    .footer .brand a { color: #e7e9ea; }

    @media (max-width: 560px) {
      .hats, .team-grid { grid-template-columns: 1fr; }
      .brand-name { font-size: 28px; }
      .case { padding: 20px; }
      .case-name { font-size: 19px; }
    }
    @media (max-width: 380px) {
      .logo-strip { gap: 18px 26px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade, body::before { animation: none; opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <main class="container">
    <a class="lang fade" style="animation-delay:0.02s" href="/">English</a>

    <!-- 1. BRAND HERO -->
    <div class="brandmark fade" style="animation-delay:0.05s" aria-hidden="true">
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="none">
        <circle cx="24" cy="10" r="5" fill="#1d9bf0"/>
        <circle cx="10" cy="34" r="5" fill="#1d9bf0" opacity="0.75"/>
        <circle cx="38" cy="34" r="5" fill="#1d9bf0" opacity="0.75"/>
        <path d="M24 15v8m0 0-11 8m11-8 11 8" stroke="#1d9bf0" stroke-width="2.4" stroke-linecap="round"/>
        <circle cx="24" cy="23" r="3" fill="#fff"/>
      </svg>
    </div>
    <h1 class="brand-name fade" style="animation-delay:0.12s">FutureProof <span>Agents</span></h1>
    <div class="brand-sub fade" style="animation-delay:0.16s">מערכות סוכני AI · מוטמעות בעסקים אמיתיים</div>
    <p class="lead fade" style="animation-delay:0.24s">אנחנו מאתרים איפה AI באמת מזיז את שורת הרווח שלכם, ובונים את זה איתכם עד שזה עובד, ונשאר אצלכם. מהאפיון ועד ההטמעה המלאה. <b>בני אדם איפה שצריך שיקול דעת, סוכנים איפה שצריך מהירות.</b> כל פתרון נמדד בשורת הרווח, לא בטוקנים.</p>
    <a class="cta fade" style="animation-delay:0.3s" href={waLink} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      דברו איתנו בוואטסאפ
    </a>

    <!-- 2. TRUST: LOGOS -->
    <hr class="divider fade" style="animation-delay:0.4s" />
    <section class="fade" style="animation-delay:0.42s">
      <div class="section-title">חברות שעבדנו ועובדים איתן</div>
      <div class="logo-strip">
        <img src="/logos/ginger.svg" alt="Ginger" class="tall" />
        <img src="/logos/jvp.png" alt="JVP" />
        <img src="/logos/shenkar.svg" alt="שנקר" class="tall" />
        <span class="logo-word">דיזנהאוז</span>
        <span class="logo-mark"><img src="/logos/diviners.png" alt="Diviners" style="height:28px" /><span class="logo-word">Diviners</span></span>
        <span class="logo-word mono">IPRACTICOM</span>
        <span class="logo-word">Spark Founder Lab</span>
      </div>
    </section>

    <!-- 3. METHOD: FOUR HATS -->
    <hr class="divider fade" style="animation-delay:0.44s" />
    <section class="fade" style="animation-delay:0.45s">
      <div class="method-head">
        <div class="section-title">איך אנחנו עובדים</div>
        <h2>ארבעה כובעים</h2>
        <div class="sub">ארבעה מקומות שבהם AI מזיז את שורת הרווח</div>
        <p class="tag">כל חברה רצה על ארבעה כובעים. אנחנו ממפים את הכאב לכובע הנכון, מייצרים ניצחון ראשון, ומתרחבים לטרנספורמציה מלאה.</p>
      </div>
      <div class="hats">
        {hats.map((h) => (
          <article class="hat">
            <div class="icon">{h.icon}</div>
            <h3>{h.title}</h3>
            <p>{h.desc}</p>
          </article>
        ))}
      </div>
      <p class="method-foot">מתחילים באפיון, מייצרים <b>ניצחון ראשון שמרגישים מיד</b>, ומתרחבים בהדרגה לטרנספורמציה מלאה.</p>
    </section>

    <!-- 4. PROOF: SELECTED PROJECTS -->
    <hr class="divider fade" style="animation-delay:0.46s" />
    <section class="fade" style="animation-delay:0.48s">
      <div class="section-title">פרויקטים נבחרים</div>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <div class="case-head">
              <span class="case-name">{c.name}</span>
              <span class="case-tag">{c.tag}</span>
            </div>
            <div class="case-row">
              <div class="k">מה בנינו</div>
              <div class="v">{c.built}</div>
            </div>
            <div class="case-row">
              <div class="k">התוצאה</div>
              <div class="v">{c.outcome}</div>
            </div>
            {c.quote && (
              <div class="quote">
                <p>"{c.quote}"</p>
                <div class="who">— {c.who}</div>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- 5. THE TEAM -->
    <hr class="divider fade" style="animation-delay:0.51s" />
    <section class="fade" style="animation-delay:0.52s">
      <div class="method-head">
        <div class="section-title">הצוות</div>
        <h2>בני אדם וסוכנים, צוות אחד</h2>
        <p class="tag">זה לא איש אחד. זו אופרציה: צוות של אנשים וסוכני פיתוח AI שעובדים כאחד.</p>
      </div>
      <div class="team-grid">
        {team.map((t) => (
          <article class={t.fleet ? 'member wide' : 'member'}>
            <svg class="p-avatar" viewBox="0 0 76 76" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id={`g-${t.hue.slice(1)}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color={t.hue} stop-opacity="0.9"/>
                  <stop offset="100%" stop-color={t.hue} stop-opacity="0.35"/>
                </linearGradient>
              </defs>
              <circle cx="38" cy="38" r="36" fill="#101418" stroke={t.hue} stroke-opacity="0.5" stroke-width="2"/>
              <circle cx="38" cy="30" r="11" fill={`url(#g-${t.hue.slice(1)})`}/>
              <path d="M16 62c3.5-12 12-17 22-17s18.5 5 22 17" fill={`url(#g-${t.hue.slice(1)})`}/>
            </svg>
            <h3>{t.role}</h3>
            <p>{t.desc}</p>
            {t.fleet && (
              <>
                <div class="fleet">
                  {Array.from({ length: 7 }).map(() => (
                    <span class="bot" title="סוכן פיתוח AI">
                      <svg viewBox="0 0 26 26" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#1d9bf0" stroke-width="1.8">
                        <rect x="5" y="8" width="16" height="12" rx="3.5"/>
                        <line x1="13" y1="4" x2="13" y2="8"/>
                        <circle cx="13" cy="3.5" r="1.4" fill="#1d9bf0" stroke="none"/>
                        <circle cx="10" cy="14" r="1.5" fill="#1d9bf0" stroke="none"/>
                        <circle cx="16" cy="14" r="1.5" fill="#1d9bf0" stroke="none"/>
                      </svg>
                    </span>
                  ))}
                  {Array.from({ length: 2 }).map(() => (
                    <span class="bot human" title="מהנדס אנושי">
                      <svg viewBox="0 0 26 26" xmlns="http://www.w3.org/2000/svg" fill="none">
                        <circle cx="13" cy="10" r="4" fill="#22c55e"/>
                        <path d="M5.5 21c1.4-4.5 4.3-6.5 7.5-6.5s6.1 2 7.5 6.5" fill="#22c55e"/>
                      </svg>
                    </span>
                  ))}
                </div>
                <div class="fleet-caption">7 סוכני פיתוח AI · 2 מהנדסים אנושיים</div>
              </>
            )}
          </article>
        ))}
      </div>
      <p class="team-note">בני אדם איפה שצריך שיקול דעת, סוכנים איפה שצריך מהירות. <b>בדיוק ככה אנחנו בונים גם בתוך החברה שלכם.</b></p>
    </section>

    <!-- 6. FOUNDER -->
    <hr class="divider fade" style="animation-delay:0.53s" />
    <section class="founder fade" style="animation-delay:0.54s">
      <div class="section-title">מי מאחורי האופרציה</div>
      <img class="avatar" src="/avatar.jpg" alt="יובל קשטכר" />
      <div class="name">
        יובל קשטכר
        <svg class="verified" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .494.083.964.237 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>
      </div>
      <div class="role">יועץ ומטמיע AI · מוביל את FutureProof Agents</div>
      <p class="lead">לפני עשור הקמתי את UX Writing Hub, בית הספר הבינלאומי לכתיבת חוויית משתמש, עם יותר מאלף בוגרים בחברות הגדולות בעולם, והרצתי את כל העסק על אוטומציות. כשהגיע Claude Code, התחלתי לבנות את אותן מערכות לעסקים אחרים. היום אני מאתר איפה AI באמת מזיז את שורת הרווח, ובונה את המערכת איתכם עד שהיא עובדת, ונשארת אצלכם.</p>
    </section>

    <!-- 7. COMMUNITY: THELOOP -->
    <hr class="divider fade" style="animation-delay:0.55s" />
    <section class="loop fade" style="animation-delay:0.56s">
      <div class="section-title">מנוע הקהילה שלנו</div>
      <div class="loop-brand">the<span>LOOP</span></div>
      <div class="loop-tag">HUMANS · AGENTS · TEN MINUTES EACH</div>
      <p>מעבר לעבודה עם לקוחות, בנינו את הקהילה סביב סוכני AI בתל אביב. theLOOP הוא המיטאפ שאנחנו מארחים לאנשים שבאמת בונים: <b>שישה בונים, עשר דקות כל אחד, אפס תיאוריה</b>. יוזקייסים אמיתיים ישר מהמקלדת. האירוע הראשון נסגר ב7 דקות, ובחדר ישבו בונים מחברות כמו Wix, WSC Sports ו-Personetics. שם פוגשים אותנו הלקוחות, השותפים והגיוסים הבאים שלנו. כל ההרצאות מצולמות וזמינות ביוטיוב.</p>
      <a class="cta yt" href={loopYouTube} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="10 8 16 12 10 16 10 8"/><rect x="2.5" y="5" width="19" height="14" rx="4"/></svg>
        לצפייה בהרצאות ביוטיוב
      </a>
    </section>

    <!-- 8. CLOSING -->
    <hr class="divider fade" style="animation-delay:0.57s" />
    <section class="closing fade" style="animation-delay:0.58s">
      <h2>יש לכם עסק. לנו יש את האופרציה.</h2>
      <p>בואו נבין יחד איפה AI באמת יזיז לכם את המחט. שיחה קצרה, בלי התחייבות.</p>
      <a class="cta" href={waLink} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        דברו איתנו בוואטסאפ
      </a>
    </section>

    <SiteFooter lang="he" />
    <footer class="footer fade" style="animation-delay:0.6s">
      <div class="brand"><a href="/">FutureProof Agents</a></div>
      <div class="sub">בינה מלאכותית עסקית עם יובל קשטכר · yuvkesh</div>
    </footer>
  </main>
</body>
</html>
