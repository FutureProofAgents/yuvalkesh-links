  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    :root {
      --blue: #1d9bf0;
      --green: #25d366;
      --amber: #f59e0b;
      --line: #2f3336;
      --muted: #8b98a5;
      --text: #e7e9ea;
      --soft: #cfd9de;
      --panel: #16181c;
      --panel2: #0f1419;
    }
    html { scroll-behavior: smooth; scroll-padding-top: 80px; }
    html, body { min-height: 100%; }
    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #000;
      color: var(--text);
      display: flex;
      justify-content: center;
      padding: 0 18px 72px;
      overflow-x: clip;
      position: relative;
    }
    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.16) 0%, rgba(29,155,240,0) 68%);
      filter: blur(24px);
      z-index: 0;
      pointer-events: none;
    }
    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 920px;
      display: flex;
      flex-direction: column;
    }

    /* --- sticky part nav --- */
    .pagenav {
      position: sticky;
      top: 0;
      z-index: 20;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 0;
      margin-bottom: 34px;
      background: rgba(0,0,0,0.84);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      flex-wrap: wrap;
    }
    .pagenav a {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 7px 14px;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .pagenav a:hover { color: #fff; border-color: var(--blue); background: rgba(29,155,240,0.10); }
    .pagenav .home { color: var(--blue); border-color: rgba(29,155,240,0.32); }

    /* --- document header --- */
    .doc-tag {
      align-self: flex-start;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--blue);
      background: rgba(29,155,240,0.12);
      border: 1px solid rgba(29,155,240,0.24);
      padding: 6px 14px;
      border-radius: 6px;
      margin-bottom: 20px;
      letter-spacing: 0.4px;
    }
    h1 {
      font-size: clamp(27px, 3.9vw, 42px);
      line-height: 1.22;
      color: #fff;
      font-weight: 800;
      max-width: 800px;
    }
    .doc-sub {
      font-size: 17px;
      line-height: 1.7;
      color: var(--soft);
      max-width: 760px;
      margin-top: 14px;
    }
    .meta-row {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 30px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 18px 0;
    }
    .meta .k { color: var(--muted); font-size: 11px; font-weight: 800; margin-bottom: 5px; letter-spacing: 0.4px; }
    .meta .v { color: #fff; font-size: 14px; font-weight: 700; line-height: 1.5; }

    /* --- exec summary --- */
    .summary {
      background: linear-gradient(180deg, rgba(29,155,240,0.10), rgba(22,24,28,1) 76%);
      border: 1px solid rgba(29,155,240,0.32);
      border-radius: 10px;
      padding: 26px;
      margin-top: 34px;
    }
    .summary h2 { color: #fff; font-size: 19px; font-weight: 800; margin-bottom: 16px; }
    .summary ol { list-style: none; counter-reset: s; display: flex; flex-direction: column; gap: 13px; }
    .summary li {
      counter-increment: s;
      color: var(--soft);
      font-size: 15.5px;
      line-height: 1.75;
      padding-inline-start: 32px;
      position: relative;
    }
    .summary li::before {
      content: counter(s);
      position: absolute;
      inset-inline-start: 0;
      top: 2px;
      width: 22px;
      height: 22px;
      border-radius: 4px;
      background: rgba(29,155,240,0.16);
      color: var(--blue);
      font-size: 11.5px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* --- toc --- */
    .toc {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 24px 26px;
      margin-top: 18px;
      background: var(--panel2);
    }
    .toc h2 { color: #fff; font-size: 17px; font-weight: 800; margin-bottom: 16px; }
    .toc-part { margin-bottom: 16px; }
    .toc-part:last-child { margin-bottom: 0; }
    .toc-part .ph {
      font-size: 12px;
      font-weight: 800;
      color: var(--blue);
      letter-spacing: 0.5px;
      margin-bottom: 7px;
    }
    .toc a {
      display: block;
      color: var(--soft);
      text-decoration: none;
      font-size: 14.5px;
      line-height: 1.6;
      padding: 3px 0;
    }
    .toc a:hover { color: #fff; }
    .toc a .tn {
      display: inline-block;
      min-width: 26px;
      color: var(--muted);
      font-weight: 800;
      font-size: 13px;
    }

    /* --- part bands --- */
    .part { width: 100%; scroll-margin-top: 80px; }
    .part-band {
      width: 100%;
      border-top: 2px solid var(--blue);
      padding-top: 22px;
      margin: 56px 0 8px;
    }
    .part-band .ph {
      font-size: 12px;
      font-weight: 800;
      color: var(--blue);
      letter-spacing: 0.7px;
      margin-bottom: 6px;
    }
    .part-band h2 {
      font-size: clamp(22px, 3vw, 29px);
      font-weight: 800;
      color: #fff;
      line-height: 1.25;
    }

    /* --- sections --- */
    section { width: 100%; scroll-margin-top: 80px; }
    .sec-head {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin: 40px 0 14px;
    }
    .sec-head .sn {
      font-size: 15px;
      font-weight: 900;
      color: var(--blue);
      flex-shrink: 0;
      min-width: 26px;
    }
    .sec-head h3 {
      font-size: clamp(19px, 2.4vw, 23px);
      font-weight: 800;
      color: #fff;
      line-height: 1.3;
    }
    p.body {
      color: var(--soft);
      font-size: 15.5px;
      line-height: 1.85;
      margin-bottom: 14px;
    }
    p.body b { color: #fff; font-weight: 700; }

    /* --- sub-blocks --- */
    .blocks { display: flex; flex-direction: column; gap: 12px; }
    .block {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 22px;
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 16px;
      align-items: start;
    }
    .block .bn {
      font-size: 14px;
      font-weight: 900;
      color: var(--blue);
      padding-top: 3px;
      direction: ltr;
      text-align: start;
    }
    .block h4 { color: #fff; font-size: 17.5px; font-weight: 800; line-height: 1.35; margin-bottom: 9px; }
    .block p { color: var(--soft); font-size: 15px; line-height: 1.75; }
    .block .out {
      margin-top: 12px;
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.65;
      border-inline-start: 2px solid rgba(29,155,240,0.35);
      padding-inline-start: 12px;
    }
    .block .out b { color: var(--blue); font-weight: 800; }

    /* --- tables --- */
    .tbl {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      background: var(--panel2);
      margin-top: 6px;
    }
    .tbl-head, .tbl-row { display: grid; }
    .cmp .tbl-head, .cmp .tbl-row { grid-template-columns: 200px 1fr 1fr; }
    .app .tbl-head, .app .tbl-row { grid-template-columns: 34px 1.05fr 1.35fr 1.15fr 134px; }
    .req .tbl-head, .req .tbl-row { grid-template-columns: 34px 1fr 92px; }
    .tbl-head { background: #000; border-bottom: 1px solid var(--line); }
    .tbl-head div {
      padding: 13px 16px;
      font-size: 12.5px;
      font-weight: 800;
      color: var(--muted);
      letter-spacing: 0.3px;
    }
    .tbl-head .a { color: #fff; }
    .tbl-head .b { color: var(--blue); }
    .tbl-row { border-bottom: 1px solid var(--line); }
    .tbl-row:last-child { border-bottom: none; }
    .tbl-row > div { padding: 15px 16px; font-size: 14px; line-height: 1.7; color: var(--soft); }
    .tbl-row .k { color: #fff; font-weight: 700; background: rgba(255,255,255,0.02); }
    .tbl-row .num { color: var(--blue); font-weight: 900; font-size: 13px; }
    .tbl-row .a { border-inline-start: 1px solid var(--line); }
    .tbl-row .b { border-inline-start: 1px solid var(--line); background: rgba(29,155,240,0.045); }
    .tbl-row .mob-k { display: none; }
    .tag {
      display: inline-block;
      font-size: 11.5px;
      font-weight: 800;
      padding: 3px 9px;
      border-radius: 4px;
      white-space: nowrap;
      max-width: 100%;
      overflow-wrap: break-word;
    }
    .tag.must { color: #ff6b6b; background: rgba(255,107,107,0.13); }
    .tag.high { color: var(--amber); background: rgba(245,158,11,0.13); }
    .tag.eff { color: var(--muted); background: rgba(139,152,165,0.13); }
    .mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 900;
      margin-inline-end: 7px;
      vertical-align: -3px;
    }
    .mark.no { background: rgba(245,158,11,0.16); color: var(--amber); }
    .mark.yes { background: rgba(37,211,102,0.16); color: var(--green); }
    .mark.neutral { background: rgba(139,152,165,0.16); color: var(--muted); }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 22px;
      margin-top: 12px;
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 700;
    }
    .legend .mark { width: 16px; height: 16px; font-size: 10px; }

    /* --- notes --- */
    .note {
      border-inline-start: 3px solid var(--amber);
      background: rgba(245,158,11,0.07);
      color: var(--soft);
      line-height: 1.8;
      font-size: 15px;
      padding: 20px 22px;
      border-radius: 10px;
      margin-top: 16px;
    }
    .note b { color: #fff; font-weight: 700; }
    .note.green { border-inline-start-color: var(--green); background: rgba(37,211,102,0.07); }
    .note.blue { border-inline-start-color: var(--blue); background: rgba(29,155,240,0.07); }
    .note .t { color: #fff; font-weight: 800; font-size: 16px; margin-bottom: 7px; }

    /* --- role / background cards --- */
    .cards2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 22px;
    }
    .card .pill {
      display: inline-block;
      color: var(--blue);
      background: rgba(29,155,240,0.12);
      border: 1px solid rgba(29,155,240,0.24);
      border-radius: 5px;
      padding: 4px 11px;
      font-size: 11.5px;
      font-weight: 800;
      margin-bottom: 12px;
    }
    .card h4 { color: #fff; font-size: 17px; font-weight: 800; margin-bottom: 12px; }
    .card p { color: var(--soft); font-size: 14.5px; line-height: 1.7; }

    ul.clean { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    ul.clean li {
      color: var(--soft);
      font-size: 14.5px;
      line-height: 1.7;
      padding-inline-start: 22px;
      position: relative;
    }
    ul.clean li::before {
      content: "";
      position: absolute;
      inset-inline-start: 0;
      top: 9px;
      width: 6px;
      height: 6px;
      border-radius: 2px;
      background: var(--blue);
    }

    /* --- cta --- */
    .cta-wrap { margin-top: 28px; }
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 54px;
      padding: 14px 30px;
      background: var(--green);
      color: #04210f;
      border-radius: 8px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 800;
      box-shadow: 0 8px 24px rgba(37,211,102,0.18);
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .cta svg { width: 21px; height: 21px; fill: #04210f; }
    .cta:hover { transform: translateY(-2px); filter: brightness(1.05); }
    .cta-sub { font-size: 14px; color: var(--muted); margin-top: 14px; line-height: 1.8; }
    .cta-sub a { color: var(--blue); text-decoration: none; font-weight: 700; }

    /* --- appendix --- */
    .src-list { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-top: 10px; }
    .src-list a {
      direction: ltr;
      unicode-bidi: isolate;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: 4px 12px;
      font-size: 12px;
      line-height: 1.5;
    }
    .src-list a:hover { color: var(--blue); border-color: rgba(29,155,240,0.34); }

    .endnote {
      margin-top: 46px;
      color: var(--muted);
      text-align: center;
      font-size: 12px;
      line-height: 1.7;
    }
    .endnote a { color: var(--text); text-decoration: none; font-weight: 800; }

    @media (max-width: 880px) {
      .cards2, .meta-row { grid-template-columns: 1fr; }
      .meta-row { gap: 16px; }
      .cmp .tbl-head, .app .tbl-head, .req .tbl-head { display: none; }
      .cmp .tbl-row, .app .tbl-row, .req .tbl-row { grid-template-columns: 1fr; border-bottom: 8px solid #000; }
      .tbl-row > div { padding: 13px 16px; }
      .tbl-row .k { font-size: 15.5px; border-bottom: 1px solid var(--line); }
      .tbl-row .a, .tbl-row .b { border-inline-start: none; }
      .tbl-row .mob-k {
        display: block;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: 0.3px;
        margin-bottom: 5px;
      }
      .tbl-row .a .mob-k { color: var(--muted); }
      .tbl-row .b .mob-k { color: var(--blue); }
      .block { grid-template-columns: 1fr; gap: 8px; }
      .summary, .toc, .card, .note { padding: 20px; }
    }

    @media print {
      body { background: #fff; color: #111; padding: 0; }
      body::before, .pagenav, .cta-wrap { display: none; }
      .part { page-break-after: always; }
      .part:last-of-type { page-break-after: auto; }
      .card, .block, .tbl, .summary, .toc, .note { border-color: #ccc; background: #fff; }
      h1, h2, h3, h4, .tbl-row .k { color: #000; }
      p, .card p, .block p, ul.clean li, .summary li { color: #222; }
    }
  </style>
</head>
