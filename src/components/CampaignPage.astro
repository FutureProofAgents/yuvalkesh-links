---
import LocalFonts from './LocalFonts.astro';
const he=Astro.props.lang==='he';
const t=(en:string,heb:string)=>he?heb:en;
const canonical=`https://futureproofagents.com/${he?'he/':''}ai-transformation/`;
const services=he?[
 ['01','שיווק שממשיך לעבוד','מנועי תוכן שמכירים את העסק, מחקר שוק, יצירת קמפיינים ותהליכי הפצה עם בקרה אנושית.','מהרעיון עד לפרסום ולמדידה'],
 ['02','מכירות עם יותר הקשר','מחקר לקוחות, העשרת לידים, סיכומי שיחות, מעקב אחרי הזדמנויות וסוכנים שמעדכנים את ה־CRM.','פחות אדמיניסטרציה. יותר שיחות טובות.'],
 ['03','תפעול בלי העבודה החוזרת','חיבור נתונים בין מערכות, טיפול במסמכים, דוחות ותהליכי חיוב שמתקדמים עם נקודות אישור ברורות.','העבודה עוברת בין המערכות שלכם'],
 ['04','שירות שעושה את הצעד הבא','סוכני שירות שמוצאים מידע, פותחים בקשות, מתאמים פגישות ומעבירים לאדם כשצריך.','מתשובה לפעולה בתוך התהליך'],
 ['05','ידע ארגוני שאפשר להשתמש בו','חיבור נהלים, מסמכים וידע מקצועי למאגר שאפשר לחפש בו ולקבל ממנו תשובות עם מקורות.','הידע של החברה, נגיש לצוות'],
 ['06','צוות שיודע לעבוד עם AI','סדנאות מעשיות סביב העבודה של המחלקה, הדרכה על המערכת שבנינו ותהליכי עבודה שאפשר להמשיך לבד.','בונים יכולת שנשארת אצלכם']
]:[
 ['01','Marketing that keeps moving','Content engines grounded in your business, market research, campaign creation and publishing workflows with human review.','From the first idea to delivery and measurement'],
 ['02','Sales with better context','Prospect research, lead enrichment, call summaries, follow-ups and agents that keep your CRM current.','Less administration. More useful conversations.'],
 ['03','Operations without the repetition','Connect data across systems, process documents, prepare reports and move billing workflows through clear approval points.','Work moves through the tools you already use'],
 ['04','Service that takes the next step','Customer-facing agents that find answers, open requests, book meetings and hand over to a person when needed.','From answering a question to moving work forward'],
 ['05','Company knowledge, within reach','Turn procedures, documents and specialist knowledge into a searchable resource with answers linked to their sources.','Your team can use what your company knows'],
 ['06','A team ready to use AI','Hands-on department workshops, training on the systems we build and practical workflows your team can keep running.','Build capability that stays with your business']
];
const process=he?[
 ['ממפים את העסק','מבינים איך העבודה באמת נעשית, איפה היא נעצרת, ואילו מערכות ואנשים מעורבים.','מפת תהליך והזדמנויות'],
 ['בוחרים התחלה נכונה','מדרגים הזדמנויות לפי ערך עסקי, מאמץ ומגבלות. מגדירים היקף, עלויות ומדדי הצלחה.','תוכנית עבודה עם יעד ברור'],
 ['בונים ומחברים','מפתחים את הסוכנים והאוטומציות, מחברים למערכות שלכם ומגדירים הרשאות ואישורים.','מערכת שמתאימה לעבודה שלכם'],
 ['בודקים ומטמיעים','בודקים תרחישים אמיתיים וחריגים, מריצים פיילוט עם הצוות, משפרים ומדריכים.','השקה עם צוות שיודע להשתמש בה'],
 ['מודדים ומרחיבים','עוקבים אחרי התוצאות, מתקנים תקלות ומשפרים. מרחיבים לתהליכים נוספים לפי ההיקף שסוכם.','שיפור מתמשך על בסיס שימוש אמיתי']
]:[
 ['Map the business','Understand how work actually happens, where it slows down, and the people and systems involved.','A workflow map and opportunity shortlist'],
 ['Choose the right first move','Prioritize by business value, effort and constraints. Agree on scope, costs and what success looks like.','A delivery plan with a clear business target'],
 ['Build and connect','Develop agents and automations, connect your existing tools, and define access and approval controls.','A system designed around your workflow'],
 ['Test and put it to work','Test real cases and exceptions, pilot with your team, improve the system and train the people using it.','A working launch with your team on board'],
 ['Measure and improve','Review results, resolve issues and refine the system. Expand into more workflows under the agreed support scope.','Ongoing improvement informed by actual use']
];
const cases=he?[
 ['JVP','מחקר משקיעים','חיבור ה־CRM, מידע מהרשת ולינקדאין לתהליך שמייצר מסמך הכנה על משקיע, עם מקורות ובפורמט של הקרן.','צוות קשרי המשקיעים קיבל תהליך אחד להכנת תדריכים במקום איסוף מידע ידני ממספר מקורות.'],
 ['Ginger','שירות לקוחות','סוכן שמגיש בקשות לאישור MRI במייל ומתאם שיחה עם מנהל תיק, יחד עם מנגנון בדיקה והטמעה במערכת החברה.','הסוכן פועל בסביבת הייצור ומבצע פעולות בתהליך השירות.'],
 ['iPracticom','תפעול שיווק','מערכת ידע ותוכן המחברת קריאייטיב, כתיבה, תזמון ומעקב בתוך תהליך עבודה אחד.','המערכת מייצרת פוסטים וגרפיקה בפועל. בעקבות השימוש התבקשה הרחבה לידע הארגוני ולתמיכה.']
]:[
 ['JVP','Investor research','Connected CRM, web and LinkedIn research into an investor briefing workflow, with sources and the fund’s own document format.','The investor relations team received a connected briefing process in place of manual research across separate sources.'],
 ['Ginger','Customer service','Built an agent that sends MRI approval requests by email and books a call with a case manager, with evaluation and an isolated integration.','The agent went live and performs real actions inside the customer service workflow.'],
 ['iPracticom','Marketing operations','Built a company knowledge and content system connecting creative work, writing, scheduling and monitoring.','The system produces posts and graphics in practice. Its use led to a request to expand into organizational knowledge and support.']
];
const revenue=[['pre_revenue','Pre-revenue','לפני הכנסות'],['under_250k','Under 250K','עד 250 אלף'],['250k_1m','250K–1M','250 אלף–מיליון'],['1m_5m','1M–5M','1–5 מיליון'],['5m_20m','5M–20M','5–20 מיליון'],['20m_100m','20M–100M','20–100 מיליון'],['100m_plus','100M+','מעל 100 מיליון'],['undisclosed','Prefer to discuss','מעדיפים לדבר על זה']];
const solutions=[['marketing','Marketing & content','שיווק ותוכן'],['sales','Sales & CRM','מכירות ו־CRM'],['operations','Operations & automation','תפעול ואוטומציה'],['service','Customer service','שירות לקוחות'],['knowledge','Company knowledge','ידע ארגוני'],['not_sure','Help me find the opportunity','עזרו לי למצוא את ההזדמנות']];
const faqs=he?[
 ['צריך לדעת מראש איזה פתרון אנחנו צריכים?','ממש לא. מספיק לספר מה העסק עושה ומה גוזל לכם זמן או מעכב צמיחה. נתחיל משם ונבדוק יחד איפה נכון להשקיע.'],
 ['אתם גם מייעצים וגם בונים?','כן. העבודה יכולה לכלול מיפוי תהליכים, תכנון, פיתוח, חיבור למערכות, בדיקות, הדרכת הצוות ותמיכה. ההיקף נקבע יחד לפני תחילת הפרויקט.'],
 ['המערכות הקיימות שלנו יכולות להישאר?','זו נקודת המוצא. בשלב המיפוי נבדוק חיבורים ל־CRM, למייל, ליומן, למסמכים ולמערכות התפעול שלכם. היתכנות החיבור תלויה בהרשאות וביכולות של כל מערכת.'],
 ['כמה זה עולה וכמה זמן זה לוקח?','זה תלוי בתהליך, בכמות החיבורים ובמצב הנתונים. אחרי שיחת היכרות ומיפוי נוכל להגדיר שלבים, לוח זמנים והצעת מחיר. פירוט עלויות כלים ותחזוקה ייכלל בהצעה.'],
 ['מה לגבי פרטיות ואישורים?','במהלך התכנון מגדירים למי יש גישה, איזה מידע המערכת צריכה, ואילו פעולות דורשות אישור אנושי. בוחנים את הדרישות הספציפיות של הארגון לפני ההטמעה.']
]:[
 ['Do we need to know which AI solution we want?','No. Tell us what your business does and where time gets lost or growth gets held up. We will start there and work out which opportunities are worth exploring.'],
 ['Do you advise and implement?','Yes. An engagement can cover process mapping, solution design, development, integrations, testing, team training and support. We agree on the scope before the project begins.'],
 ['Can we keep our existing tools?','That is the starting point. We assess connections to your CRM, email, calendar, documents and operational systems. Integration feasibility depends on each tool’s capabilities and your access.'],
 ['What does it cost, and how long does it take?','It depends on the workflow, integrations and state of your data. After an initial conversation and mapping, we can define phases, a timeline and a proposal, including tool and maintenance costs.'],
 ['How do you handle data and approvals?','During design, we define access, the information the system needs, and the actions that require human approval. We assess your organization’s requirements before implementation.']
];
---
<!doctype html><html lang={he?'he':'en'} dir={he?'rtl':'ltr'}><head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{t('AI implementation, from first idea to everyday work | FutureProof Agents','הטמעת AI לעסקים, מהרעיון עד לעבודה בפועל | FutureProof Agents')}</title>
 <meta name="description" content={t('FutureProof Agents maps, builds and implements AI systems for marketing, sales, operations and service. Tell us about your business and find the right place to start.','ממפים, בונים ומטמיעים מערכות AI לשיווק, מכירות, תפעול ושירות. ספרו לנו על העסק ונמצא יחד את המקום הנכון להתחיל.')} />
 <link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href="https://futureproofagents.com/ai-transformation/"/><link rel="alternate" hreflang="he" href="https://futureproofagents.com/he/ai-transformation/"/><link rel="alternate" hreflang="x-default" href="https://futureproofagents.com/ai-transformation/"/>
 <meta property="og:title" content={t('Make AI part of how your business works.','הופכים AI לחלק מהעבודה בעסק שלכם.')}/><meta property="og:description" content={t('Business mapping. Custom agents. Real implementation. One team, end to end.','מיפוי עסקי, סוכנים מותאמים והטמעה בפועל. צוות אחד, מקצה לקצה.')}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://futureproofagents.com/avatar.jpg"/>
 <link rel="icon" href="/favicon.svg" type="image/svg+xml"/><LocalFonts hebrew={he} primary={he?'heebo':'inter'}/>
 <script is:inline src="/scripts/analytics.js" defer></script>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Service',name:'Business AI implementation',provider:{'@type':'Organization',name:'FutureProof Agents',url:'https://futureproofagents.com'},url:canonical,serviceType:'Business process mapping, AI agent development, integration and training',inLanguage:he?'he':'en'})}/>
</head><body>
 <a class="skip" href="#main">{t('Skip to content','דילוג לתוכן')}</a>
 <header class="nav wrap"><a href={he?'/he/':'/'} class="brand" aria-label="FutureProof Agents"><img src="/favicon.svg" width="36" height="36" alt=""/><span>FutureProof<span class="brand-sub">AGENTS</span></span></a><nav aria-label={t('Page navigation','ניווט בעמוד')}><a href="#work">{t('Our work','העבודה שלנו')}</a><a href="#process">{t('The process','התהליך')}</a><a data-language href={he?'/ai-transformation/':'/he/ai-transformation/'} lang={he?'en':'he'}>{he?'English':'עברית'}</a><a class="button small" href="#start">{t('Let’s talk','בואו נדבר')} <span aria-hidden="true">↗</span></a></nav></header>
 <main id="main">
 <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span>{t('AI IMPLEMENTATION. END TO END.','הטמעת AI לעסקים. מקצה לקצה.')}</p><h1>{t('Make AI part of how your','הופכים AI לחלק מהעבודה')} <em>{t('business works.','בעסק שלכם.')}</em></h1><p class="intro">{t('We find where AI can make a real difference, then build it into your business. From mapping the work to connecting your tools, training your team and making it run.','מוצאים איפה AI יכול להשפיע באמת, ואז בונים אותו לתוך העסק. ממיפוי העבודה, דרך חיבור המערכות ועד הדרכת הצוות והטמעה בפועל.')}</p><a class="button" href="#start">{t('Find your first AI opportunity','בואו נמצא את ההזדמנות שלכם')} <span aria-hidden="true">↗</span></a><p class="micro">{t('A short introduction. A practical starting point. No commitment.','היכרות קצרה. נקודת התחלה מעשית. בלי התחייבות.')}</p></div>
 <div class="system-art" aria-label={t('Your people, knowledge and tools connected through a working AI system','האנשים, הידע והמערכות שלכם מחוברים לתהליך עבודה עם AI')}><div class="art-top"><span class="dot"></span><span>{t('YOUR BUSINESS, CONNECTED','העסק שלכם, מחובר')}</span><span>01—04</span></div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-core"><img src="/favicon.svg" width="78" height="78" alt=""/><b>FutureProof</b><span>{t('People + AI agents','אנשים + סוכני AI')}</span></div><div class="node node-a"><span>01</span><b>{t('Your knowledge','הידע שלכם')}</b><small>{t('Documents · context','מסמכים · הקשר')}</small></div><div class="node node-b"><span>02</span><b>{t('Your tools','המערכות שלכם')}</b><small>CRM · Email · Data</small></div><div class="node node-c"><span>03</span><b>{t('Your team','הצוות שלכם')}</b><small>{t('Judgment · approval','שיקול דעת · אישור')}</small></div><div class="node node-d"><span>04</span><b>{t('Work, moving','העבודה מתקדמת')}</b><small>{t('Actions · follow-through','פעולות · מעקב')}</small></div><div class="art-bottom"><span>MAP → BUILD → IMPLEMENT</span><span class="dot"></span></div></div>
 </section>
 <section class="trust wrap" aria-label={t('Companies we have worked with','חברות שעבדנו ואנחנו עובדים איתן')}><p class="eyebrow muted">{t('COMPANIES WE HAVE WORKED AND WORK WITH','חברות שעבדנו ואנחנו עובדים איתן')}</p><div class="logos"><img src="/logos/ginger.svg" alt="Ginger" width="100" height="40"/><img src="/logos/jvp.png" alt="JVP" width="90" height="40"/><img src="/logos/shenkar.svg" alt="Shenkar" width="100" height="40"/><span>Diesenhaus</span><span class="diviners"><img src="/logos/diviners.png" alt="" width="27" height="27"/>Diviners</span><span class="ip">IPRACTICOM</span><span>Spark Founder Lab</span></div></section>
 <section class="section wrap" id="solutions"><div class="section-heading"><div><p class="eyebrow">{t('WHERE WE CAN HELP','איפה אנחנו נכנסים לתמונה')}</p><h2>{t('Start with the work.','מתחילים מהעבודה.')}<br/>{t('Build the right system.','בונים את המערכת הנכונה.')}</h2></div><p>{t('One workflow or a wider transformation. We connect the people, information and tools around the outcome your business needs.','תהליך אחד או שינוי רחב יותר. מחברים אנשים, מידע ומערכות סביב התוצאה שהעסק שלכם צריך.')}</p></div><div class="services">{services.map(([n,title,body,note])=><article><span class="number">{n}</span><h3>{title}</h3><p>{body}</p><span class="service-note">{note}</span></article>)}</div></section>
 <section class="case-section section" id="work"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{t('SELECTED CLIENT WORK','דוגמאות מהשטח')}</p><h2>{t('Built around a real business.','נבנה סביב עסק אמיתי.')}</h2></div><p>{t('Different industries. Different problems. Systems connected to the work people actually do.','ענפים שונים. אתגרים שונים. מערכות שמחוברות לעבודה שאנשים עושים בפועל.')}</p></div><div class="cases">{cases.map(([name,tag,body,outcome],i)=><article><div class="case-brand"><span>{name}</span><small>{tag}</small></div><span class="case-index">0{i+1}</span><h3>{i===0?t('From scattered sources to a useful briefing','ממקורות מפוזרים לתדריך שימושי'):i===1?t('From a customer request to a real action','מפניית לקוח לפעולה אמיתית'):t('From company knowledge to published content','מהידע של החברה לתוכן שמתפרסם')}</h3><p>{body}</p><div class="outcome"><span class="eyebrow">{t('IN PRACTICE','בפועל')}</span><p>{outcome}</p></div></article>)}</div><p class="case-note">{t('Selected projects, as described in our published case studies. Scope and results vary by project.','פרויקטים נבחרים מתוך תיאורי המקרה שפרסמנו. ההיקף והתוצאות משתנים בין פרויקטים.')} <a href={he?'/he/':'/'}>{t('More about our work ↗','עוד על העבודה שלנו ↗')}</a></p></div></section>
 <section class="section wrap process" id="process"><div class="process-intro"><p class="eyebrow">{t('ONE TEAM. THE WHOLE JOURNEY.','צוות אחד. לאורך כל הדרך.')}</p><h2>{t('From “could we?”','מ״אולי אפשר?״')}<br/><em>{t('to everyday work.','לעבודה היומיומית.')}</em></h2><p>{t('Business understanding, engineering and team adoption belong in the same process. We stay involved through the implementation, with responsibilities and support agreed up front.','הבנת העסק, פיתוח והטמעה בצוות הם חלק מאותו תהליך. אנחנו מלווים את הבנייה עד ליישום, עם אחריות ותמיכה שמגדירים מראש.')}</p><a class="text-link" href="#start">{t('Tell us what you have in mind ↗','ספרו לנו מה יש לכם בראש ↗')}</a></div><ol>{process.map(([title,body,deliverable],i)=><li><span class="step-number">0{i+1}</span><div><h3>{title}</h3><p>{body}</p><small>{deliverable}</small></div></li>)}</ol></section>
 <section class="founder wrap"><img src="/avatar.jpg" alt={t('Yuval Keshtcher','יובל קשתכר')} width="180" height="180" loading="lazy"/><div><p class="eyebrow">{t('YOUR PARTNER IN MAKING IT WORK','השותף שלכם להטמעה שעובדת')}</p><h2>{t('Yuval Keshtcher + the FutureProof team','יובל קשתכר וצוות FutureProof')}</h2><p>{t('I founded UX Writing Hub and built an international education business with automation at its core. Today, our team combines business-process expertise, engineering and AI agents to build working systems for other businesses.','הקמתי את UX Writing Hub ובניתי עסק חינוך בינלאומי שאוטומציה נמצאת בלב הפעילות שלו. היום הצוות שלנו משלב הבנה עסקית, הנדסה וסוכני AI כדי לבנות מערכות עובדות לעסקים אחרים.')}</p><span>{t('Business mapping · Engineering · Implementation · Training','מיפוי עסקי · פיתוח · הטמעה · הדרכה')}</span></div></section>
 <section class="form-section section" id="start"><div class="wrap form-layout"><div class="form-intro"><p class="eyebrow">{t('LET’S FIND THE RIGHT START','בואו נמצא מאיפה להתחיל')}</p><h2>{t('Tell us about','ספרו לנו על')}<br/><em>{t('your business.','העסק שלכם.')}</em></h2><p>{t('A few details will help us understand your business and prepare for a useful first conversation. A rough estimate is enough.','כמה פרטים יעזרו לנו להבין את העסק ולהגיע לשיחה ראשונה מועילה. גם הערכה כללית מספיקה.')}</p><div class="next"><h3>{t('What happens next?','מה קורה אחרי ששולחים?')}</h3><p><span>01</span>{t('We review your business and the help you need.','אנחנו עוברים על העסק ועל העזרה שאתם מחפשים.')}</p><p><span>02</span>{t('We contact you to explore the opportunity.','יוצרים איתכם קשר כדי לבדוק יחד את ההזדמנות.')}</p><p><span>03</span>{t('Together, we decide on a useful next step.','מחליטים יחד מה יהיה הצעד הבא הנכון.')}</p></div><p class="privacy-short">{t('Your details are used to respond to this inquiry. This form does not subscribe you to marketing emails.','הפרטים משמשים לטיפול בפנייה. הטופס אינו מצרף אתכם לרשימת דיוור.')}</p></div>
 <div class="form-card"><form id="lead-form" data-language={he?'he':'en'} novalidate>
 <div class="form-progress" aria-label={t('Form progress','התקדמות בטופס')}>{[t('Your business','העסק'),t('Your details','הפרטים')].map((label,i)=><span data-progress={i} aria-current={i===0?'step':undefined}><b>{i+1}</b>{label}</span>)}</div>
 <p class="required-note">{t('All fields are required unless marked optional.','כל השדות נדרשים, למעט שדות שמסומנים כרשות.')}</p>
 <div class="trap" aria-hidden="true"><label>Website<input name="website_check" tabindex="-1" autocomplete="off"/></label></div>
 <fieldset data-step="0"><legend>{t('First, a little about the business','קודם, קצת על העסק')}</legend>
 <label>{t('Company / business name','שם החברה או העסק')}<input name="company" required minlength="2" maxlength="160" autocomplete="organization" dir="auto"/></label>
 <label>{t('What does your business do?','מה העסק שלכם עושה?')}<textarea name="business_description" required minlength="5" maxlength="800" rows="2" dir="auto" aria-describedby="business-hint"></textarea><small id="business-hint">{t('One sentence: what you offer and who your customers are.','במשפט אחד: מה אתם מציעים ומי הלקוחות שלכם.')}</small></label>
 <div class="revenue-row"><label>{t('Approx. annual revenue','הכנסה שנתית משוערת')}<select name="revenue_band" required><option value="">{t('Choose a range','בחרו טווח')}</option>{revenue.map(([v,en,heb])=><option value={v}>{t(en,heb)}</option>)}</select></label><label>{t('Currency','מטבע')}<select name="revenue_currency" required>{(he?['ILS','USD','EUR','GBP']:['USD','ILS','EUR','GBP']).map(v=><option value={v}>{v}</option>)}</select></label></div>
 <small>{t('A ballpark figure helps us understand your scale.','סדר גודל יעזור לנו להבין את היקף הפעילות.')}</small>
 <fieldset class="solution-group"><legend>{t('Where can we help?','איפה נוכל לעזור?')}</legend><small>{t('Choose one or more.','אפשר לבחור כמה אפשרויות.')}</small><div class="solution-options">{solutions.map(([v,en,heb])=><label><input type="checkbox" name="solutions" value={v}/><span>{t(en,heb)}</span></label>)}</div></fieldset>
 </fieldset>
 <fieldset data-step="1" hidden><legend>{t('Who should we speak with?','עם מי נדבר?')}</legend><label>{t('Full name','שם מלא')}<input name="full_name" required minlength="2" maxlength="120" autocomplete="name" dir="auto"/></label><label>{t('Job title / role','תפקיד')}<input name="job_title" required minlength="2" maxlength="120" autocomplete="organization-title" dir="auto"/></label><label>{t('Email','אימייל')}<input name="email" type="email" required maxlength="180" autocomplete="email" dir="ltr"/></label><label>{t('Phone number (optional)','מספר טלפון (רשות)')}<input name="phone" type="tel" maxlength="60" autocomplete="tel" dir="ltr"/></label><label>{t('LinkedIn profile URL (optional)','קישור לפרופיל LinkedIn (רשות)')}<input name="linkedin_url" type="url" maxlength="300" dir="ltr" aria-describedby="linkedin-hint"/><small id="linkedin-hint">https://www.linkedin.com/in/your-profile</small></label><label class="consent"><input type="checkbox" name="consent" required/><span>{t('I agree that FutureProof Agents may use these details to respond to my inquiry, as explained in the','אני מסכים/ה ש־FutureProof Agents ישתמשו בפרטים כדי לחזור אליי בקשר לפנייה, בהתאם ל־')} <a href="#inquiry-privacy">{t('inquiry privacy notice','הודעת הפרטיות')}</a>.</span></label></fieldset>
 <p id="form-error" role="alert" tabindex="-1"></p><div class="form-actions"><button type="button" data-back hidden>{t('Back','חזרה')}</button><span data-step-count>{t('Step 1 of 2','שלב 1 מתוך 2')}</span><button class="button" type="button" data-next>{t('Continue','ממשיכים')} <span aria-hidden="true">→</span></button><button class="button" type="submit" data-submit hidden>{t('Let’s find your AI opportunity','בואו נמצא את ההזדמנות')} <span aria-hidden="true">↗</span></button></div>
 <noscript><p>{t('Please enable JavaScript to use this form, or','כדי לשלוח את הטופס יש להפעיל JavaScript, או')} <a href="https://calendar.app.google/uWpM7vrcaS4JAZTQ6">{t('book a conversation here','לקבוע שיחה כאן')}</a>.</p></noscript>
 </form><div id="form-success" tabindex="-1" hidden><span class="success-mark">✓</span><p class="eyebrow">{t('YOUR INQUIRY IS IN','הפנייה הגיעה')}</p><h3>{t('Let’s put this into motion.','בואו נתחיל להזיז דברים.')}</h3><p>{t('Thank you. We have received your details and will contact you at the email you provided. Choose a time for a free AI consultation with Yuval below.','תודה. קיבלנו את הפרטים וניצור קשר באימייל שהשארתם. אפשר לבחור עכשיו מועד לשיחת ייעוץ AI ללא עלות עם יובל.')}</p><a class="button" href="https://calendar.app.google/uWpM7vrcaS4JAZTQ6" target="_blank" rel="noopener noreferrer">{t('Book your free session ↗','קביעת שיחת ייעוץ ללא עלות ↗')}</a></div></div></div></section>
 <section class="section wrap faq"><div><p class="eyebrow">{t('GOOD QUESTIONS','שאלות טובות')}</p><h2>{t('Before we talk.','לפני שמדברים.')}</h2></div><div>{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
 <section class="wrap privacy" id="inquiry-privacy"><details><summary>{t('Inquiry privacy notice','הודעת פרטיות לפניות')}</summary><p>{t('FutureProof Agents uses the contact and business details you submit to assess and respond to your inquiry. Your submission is stored in our private lead database and a private Google spreadsheet. A new-lead email with your inquiry details is also sent to our team. It includes the page language, referral source and campaign identifiers supplied in the link, so we can understand which campaign brought the inquiry. We keep first and latest referral details in browser session storage. A hashed network identifier helps prevent spam. Optional website analytics are controlled separately by your analytics preference. We do not automatically add you to a mailing list or send these form answers to an advertising platform. After a successful submission, we send OpenAI a lead-conversion event with the page language, event time and any OpenAI ad-click identifier, to measure our campaigns. Contact details and form answers are excluded from that event. Contact us through our website to request access, correction or deletion of your inquiry details.','FutureProof Agents משתמשים בפרטי הקשר והעסק שתמסרו כדי לבחון את הפנייה ולחזור אליכם. הפנייה נשמרת במאגר הלידים הפרטי שלנו ובגיליון Google פרטי. בנוסף נשלחת לצוות שלנו התראה באימייל עם פרטי הפנייה. נשמרים גם שפת העמוד, מקור ההפניה ומזהי הקמפיין שבקישור, כדי להבין מאיזה קמפיין הגיעה הפנייה. פרטי ההפניה הראשונה והאחרונה נשמרים באחסון הסשן בדפדפן. מזהה רשת מוצפן בגיבוב עוזר למנוע ספאם. מדידת השימוש באתר היא נפרדת ובהתאם להעדפת המדידה שלכם. הטופס אינו מצרף אתכם לרשימת דיוור ואינו שולח את תשובותיכם לפלטפורמת פרסום. לאחר שהפנייה נשמרת בהצלחה, נשלח ל-OpenAI אירוע המרה הכולל את שפת העמוד, מועד האירוע ומזהה הקלקה על מודעת OpenAI, אם קיים, לצורך מדידת הקמפיינים שלנו. פרטי הקשר והתשובות בטופס אינם נכללים באירוע. אפשר לפנות אלינו דרך האתר כדי לבקש גישה, תיקון או מחיקה של פרטי הפנייה.')}</p></details></section>
 </main><footer class="wrap"><a class="brand" href={he?'/he/':'/'}>FutureProof Agents</a><p>{t('People where judgment matters. Agents where speed matters.','אנשים במקום שדורש שיקול דעת. סוכנים במקום שדורש מהירות.')}</p><a href="#start">{t('Let’s build what comes next ↗','בואו נבנה את השלב הבא ↗')}</a></footer>
 <script src="../scripts/campaign-form.ts"></script>
</body></html>
