---
import LocalFonts from './LocalFonts.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  lang: 'en' | 'he';
}

const { lang } = Astro.props;
const he = lang === 'he';
const site = Astro.site!.href.replace(/\/$/, '');
const pagePath = he ? '/he/newsletter/' : '/newsletter/';
const alternatePath = he ? '/newsletter/' : '/he/newsletter/';
const issuePath = he ? '/he/newsletter/issue-001/' : '/newsletter/issue-001/';

const copy = he
  ? {
      title: 'FutureProof — ניוזלטר AI למנהלים בכירים בלבד',
      description: 'ניוזלטר AI למנכ״לים, מייסדים פעילים והנהלה בכירה. תובנות להחלטות עסקיות, לקהל שנבחר אישית. ההצטרפות כפופה לאישור של יובל.',
      switcher: 'English',
      eyebrow: 'למנהלים בכירים בלבד · הצטרפות באישור אישי',
      headlineA: 'AI למי שמקבלים',
      headlineB: 'את ההחלטות.',
      intro: 'כשאתם אחראים על הכיוון, התקציב והביצוע, עוד עדכון על AI לא מספיק. אתם צריכים להבין במה להשקיע, מה לדחות ואילו שאלות לשאול בהנהלה. זה הניוזלטר שנכתב עבורכם — למנכ״לים, מייסדים פעילים וסמנכ״לים. כל בקשת הצטרפות נבדקת אישית על ידי יובל.',
      email: 'כתובת המייל שלך',
      cta: 'בקשת הצטרפות',
      loading: 'שולחים בקשה…',
      note: 'זו בקשת קבלה, לא הרשמה אוטומטית. יובל בוחן את התפקיד והחברה ומחליט על התאמה לקהל המנהלים הבכירים. רק לאחר אישורו ואימות המייל מצטרפים לרשימה.',
      success: 'בקשת ההצטרפות התקבלה וממתינה לאישור אישי של יובל. אם תאושר, נשלח קישור לאימות המייל לפני הצירוף לדיוור.',
      error: 'משהו השתבש. נסו שוב בעוד רגע.',
      proof: ['מנהלים בכירים בלבד', 'בדיקה אישית של יובל', 'תובנות להנהלה', 'הצטרפות באישור'],
      insideEyebrow: 'מה נכנס לכל גיליון',
      insideTitle: 'פחות רעש. יותר החלטות טובות.',
      insideIntro: 'המבנה נשאר קבוע כדי שתוכלו לקרוא מהר, להבין מה באמת השתנה, ולצאת עם החלטה ברורה.',
      sections: [
        ['01', 'השורה התחתונה', 'משפט אחד שמסביר מה באמת השתנה עבור ההנהלה השבוע.'],
        ['02', 'חמש התפתחויות', 'מאומתות, מתוארכות ומקושרות. טענות של ספקים מסומנות בבירור.'],
        ['03', 'החלטה למנכ״ל', 'פעולה אחת קונקרטית מתחת לכל סיפור — בלי מאמרי דעה.'],
        ['04', 'התמונה הגדולה', 'הדפוס שמחבר בין חמש ההתפתחויות, בחמישים מילים.'],
        ['05', 'כלי לשבוע הקרוב', 'רעיון אחד שאפשר לקחת לעבודה כבר עכשיו.'],
      ],
      latestEyebrow: 'גיליון 001 · 1 בספטמבר 2026',
      latestTitle: 'האימוץ קפץ. הרווח לא זז.',
      latestDek: 'בחברות גדולות, השימוש בסוכנים עלה כמעט בחצי. שיעור החברות שמדווחות על השפעה כלשהי על הרווח נשאר על 37%. הפער לא נובע מהטכנולוגיה. הוא נובע מהיעדר בעלות עסקית.',
      signalsTitle: 'שלושת המספרים של השבוע',
      readIssue: 'לקריאת הגיליון המלא',
      signals: [
        ['40%', 'מהחברות עם הכנסות של יותר ממיליארד דולר כבר מרחיבות שימוש בסוכנים'],
        ['37%', 'מדווחות על השפעה כלשהי על הרווח התפעולי'],
        ['6%', 'בלבד מוגדרות כבעלות ביצועי AI גבוהים'],
      ],
      moveLabel: 'המהלך',
      move: 'בחרו סוכן אחד שכבר עובד בארגון וחברו אותו לשורה בדוח רווח והפסד — עם מדד ברור ועם מנהל שאחראי עליו. אם אף אחד לא מחזיק במספר, זו עדיין לא הטמעה. זה פיילוט.',
      source: 'מקור עיקרי: סקר State of AI 2026 של מקינזי, בהשתתפות 1,719 מנהלים',
      closingEyebrow: 'FutureProof Newsletter',
      closingTitle: 'מובילים את העסק? הגישו בקשת הצטרפות.',
      closingText: 'ספרו לי מי אתם, מה התפקיד שלכם ובאיזו חברה אתם מובילים. אני בודק כל בקשה בעצמי. אם יש התאמה, תקבלו קישור לאימות המייל ולהשלמת ההצטרפות.',
      home: 'FutureProof Agents',
    }
  : {
      title: 'FutureProof — An AI newsletter exclusively for senior executives',
      description: 'An AI newsletter for CEOs, operating founders and senior executives. Practical business decisions for a personally selected readership. Admission requires Yuval’s approval.',
      switcher: 'עברית',
      eyebrow: 'Senior executives only · Personally approved',
      headlineA: 'AI for the people',
      headlineB: 'making the decisions.',
      intro: 'When you own the strategy, budget and execution, another AI update is not enough. You need to know where to invest, what to hold back and which questions to bring to leadership. This newsletter is written for CEOs, operating founders and senior executives. Yuval personally reviews every application.',
      email: 'Your work email',
      cta: 'Apply to join',
      loading: 'Submitting application…',
      note: 'This is an application, not an automatic subscription. Yuval reviews your role and company for fit with a senior executive readership. Admission requires both his approval and your email verification.',
      success: 'Your application is awaiting Yuval’s personal approval. If approved, you will receive an email verification link before joining the newsletter.',
      error: 'That did not go through. Try again in a moment.',
      proof: ['Senior executives only', 'Personally reviewed by Yuval', 'Built for leadership', 'Admission by approval'],
      insideEyebrow: 'Inside every issue',
      insideTitle: 'Less news. Better judgment.',
      insideIntro: 'The format stays fixed so you can read fast, understand what changed, and leave with a decision.',
      sections: [
        ['01', 'The thesis', 'One sentence on what actually changed for leadership this week.'],
        ['02', 'Five developments', 'Verified, dated and linked. Vendor claims are labelled as vendor claims.'],
        ['03', 'CEO move', 'One concrete decision under every story — never a think piece.'],
        ['04', 'The big picture', 'The pattern beneath the five developments, in fifty words.'],
        ['05', 'One useful thing', 'Something you can put to work this week.'],
      ],
      latestEyebrow: 'Issue 001 · September 1, 2026',
      latestTitle: 'Adoption doubled. Profit did not.',
      latestDek: 'At large companies, agent rollouts rose by nearly half. The share reporting any EBIT impact stayed flat at 37%. That gap is not a technology problem. It is an ownership problem.',
      signalsTitle: 'This week in three numbers',
      readIssue: 'Read the full issue',
      signals: [
        ['40%', 'of billion-dollar companies are now scaling AI agents'],
        ['37%', 'report any impact at all on operating profit'],
        ['6%', 'qualify as true AI high performers'],
      ],
      moveLabel: 'The move',
      move: 'Take one agent already in production and put it on a P&L line — with a named owner and a number. If nobody owns the number, you do not have a deployment. You have a pilot.',
      source: 'Primary source: McKinsey State of AI 2026 survey, 1,719 respondents',
      closingEyebrow: 'FutureProof Newsletter',
      closingTitle: 'Leading the business? Apply to join.',
      closingText: 'Tell me who you are, your role and the company you lead. I review every application myself. If there is a fit, you will receive an email verification link to complete your admission.',
      home: 'FutureProof Agents',
    };
---
<!DOCTYPE html>
<html lang={lang} dir={he ? 'rtl' : 'ltr'}>
<head>
  <script is:inline defer src="/scripts/analytics.js"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta charset="UTF-8" />
  <script is:inline>(function(){var h=location.hostname;if(h==='futureproofagents.com'||h==='localhost'||h==='127.0.0.1')return;location.replace('https://futureproofagents.com'+location.pathname+location.search+location.hash);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{copy.title}</title>
  <meta name="description" content={copy.description} />
  <meta name="theme-color" content="#000000" />
  <link rel="canonical" href={`${site}${pagePath}`} />
  <link rel="alternate" hreflang="en" href={`${site}/newsletter/`} />
  <link rel="alternate" hreflang="he" href={`${site}/he/newsletter/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/newsletter/`} />
  <meta property="og:title" content={copy.title} />
  <meta property="og:description" content={copy.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}${pagePath}`} />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta name="twitter:card" content="summary_large_image" />
  <LocalFonts hebrew={lang === 'he'} primary={lang === 'he' ? 'heebo' : 'inter'} />
  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --blue: #1d9bf0;
      --blue-soft: rgba(29, 155, 240, 0.13);
      --ink: #e7e9ea;
      --muted: #8b949e;
      --panel: #101214;
      --panel-2: #16181c;
      --line: #2f3336;
      --black: #000;
    }
    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
    body {
      min-height: 100vh;
      background: var(--black);
      color: var(--ink);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overflow-x: hidden;
    }
    html[dir='rtl'] body { font-family: 'Heebo', Arial, sans-serif; }
    body::before {
      content: '';
      position: fixed;
      inset: -280px 0 auto;
      margin: auto;
      width: min(760px, 100%);
      height: 620px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,.2), rgba(29,155,240,0) 68%);
      filter: blur(24px);
      pointer-events: none;
      z-index: 0;
    }
    a { color: inherit; }
    .confirmation-banner { padding:20px 24px; margin-top:28px; border:1px solid #327250; border-radius:14px; background:#0d251b; color:#b9efce; line-height:1.6; }
    .header-shell { width: min(1116px, calc(100% - 40px)); margin-inline: auto; }
    h1, h2 { text-wrap: balance; overflow-wrap: break-word; }
    .site-shell { position: relative; z-index: 1; }
    .topbar {
      width: min(1080px, calc(100% - 36px));
      height: 76px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 850;
      letter-spacing: -.25px;
    }
    .brand svg { width: 30px; height: 30px; }
    .brand span { color: var(--blue); }
    .top-actions { display: flex; align-items: center; gap: 10px; }
    .nav-link, .lang {
      min-height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 7px 15px;
      color: var(--muted);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 750;
      transition: border-color .2s, color .2s, background .2s;
    }
    .nav-link { border-color: transparent; }
    .nav-link:hover, .lang:hover { color: #fff; border-color: #454a50; background: rgba(255,255,255,.03); }
    main { width: min(860px, calc(100% - 36px)); margin: 0 auto; }
    .hero {
      text-align: center;
      padding: 76px 0 64px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.7px;
      text-transform: uppercase;
    }
    .eyebrow::before { content: ''; width: 24px; height: 1px; background: currentColor; }
    h1 {
      max-width: 820px;
      margin: 22px auto 0;
      font-size: clamp(36px, 6.2vw, 68px);
      line-height: 1.12;
      letter-spacing: -2.5px;
      font-weight: 900;
      color: #fff;
    }
    html[dir='rtl'] .eyebrow { letter-spacing: .2px; text-transform: none; }
    html[dir='rtl'] h1 { line-height: 1.08; letter-spacing: -1.6px; }
    h1 span { display: block; color: var(--blue); }
    .hero-copy {
      max-width: 650px;
      margin: 28px auto 0;
      color: #c7cbd0;
      font-size: clamp(16px, 2.4vw, 19px);
      line-height: 1.72;
    }
    .signup-wrap { width: min(620px, 100%); margin: 38px auto 0; }
    .signup-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
    .consent { grid-column:1/-1; display:flex; align-items:flex-start; gap:10px; text-align:start; font-size:13px; line-height:1.6; color:#bcc6d0; margin-top:4px; cursor:pointer; }
    .consent input { margin-top:4px; width:18px; height:18px; flex-shrink:0; accent-color:var(--blue); }
    .signup-form input[type='email'] {
      min-width: 0;
      min-height: 58px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--panel-2);
      color: #fff;
      padding: 0 18px;
      font: inherit;
      font-size: 15px;
      direction: ltr;
      text-align: left;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .signup-form input[type='email']::placeholder { color: #a0aab5; }
    .signup-form input[type='email']:focus { border-color: var(--blue); box-shadow: 0 0 0 4px rgba(29,155,240,.12); }
    .signup-form button {
      min-height: 58px;
      border: 0;
      border-radius: 13px;
      padding: 0 24px;
      background: var(--blue);
      color: #001522;
      font: inherit;
      font-size: 15px;
      font-weight: 850;
      cursor: pointer;
      white-space: nowrap;
      transition: transform .2s, filter .2s, box-shadow .2s;
      box-shadow: 0 10px 30px rgba(29,155,240,.2);
    }
    .signup-form button:hover { transform: translateY(-2px); filter: brightness(1.08); box-shadow: 0 14px 34px rgba(29,155,240,.28); }
    .signup-form button:disabled { cursor: wait; opacity: .66; transform: none; }
    .form-note, .form-status { margin-top: 11px; color: #a0aab5; font-size: 12.5px; line-height: 1.5; }
    .form-status:empty { display: none; }
    .form-status[data-state='success'] { color: #56d889; }
    .form-status[data-state='error'] { color: #ff7a8a; }
    .honeypot { position: absolute !important; inset-inline-start: -10000px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; }
    .proof-row {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 9px 22px;
      margin-top: 32px;
      color: var(--muted);
      font-size: 12.5px;
      font-weight: 650;
    }
    .proof-row span { display: inline-flex; align-items: center; gap: 8px; }
    .proof-row span::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 10px var(--blue); }
    .rule { border: 0; height: 1px; background: var(--line); margin: 0; }
    .section { padding: 76px 0; }
    .section-head { max-width: 650px; margin-bottom: 32px; }
    .section-head.center { margin-inline: auto; text-align: center; }
    h2 { margin-top: 12px; color: #fff; font-size: clamp(30px, 5vw, 46px); line-height: 1.1; letter-spacing: -2px; font-weight: 900; }
    html[dir='rtl'] h2 { letter-spacing: -.7px; }
    .section-head p { margin-top: 14px; color: var(--muted); font-size: 15.5px; line-height: 1.65; }
    .issue-grid { border: 1px solid var(--line); border-radius: 20px; background: rgba(16,18,20,.84); overflow: hidden; }
    .issue-row {
      display: grid;
      grid-template-columns: 64px 185px 1fr;
      gap: 18px;
      align-items: center;
      min-height: 92px;
      padding: 18px 24px;
      border-bottom: 1px solid var(--line);
      transition: background .2s;
    }
    .issue-row:last-child { border-bottom: 0; }
    .issue-row:hover { background: rgba(29,155,240,.04); }
    .issue-no { color: var(--blue); font-size: 12px; font-weight: 850; letter-spacing: 1px; }
    .issue-name { color: #fff; font-size: 15px; font-weight: 800; }
    .issue-desc { color: var(--muted); font-size: 14px; line-height: 1.55; }
    .latest {
      display: block;
      position: relative;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: linear-gradient(145deg, #15181b, #0c0e10);
      overflow: hidden;
      box-shadow: 0 28px 80px rgba(0,0,0,.42);
      color: inherit;
      text-decoration: none;
      transition: transform .25s, border-color .25s, box-shadow .25s;
    }
    .latest:hover { transform: translateY(-4px); border-color: #46505a; box-shadow: 0 34px 90px rgba(0,0,0,.55); }
    .latest:focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }
    .latest::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--blue); }
    html[dir='rtl'] .latest::before { inset: 0 0 0 auto; }
    .latest-main { padding: 42px 42px 36px; }
    .latest h2 { max-width: 650px; }
    .latest-dek { margin-top: 17px; max-width: 700px; color: #b8bdc2; font-size: 16px; line-height: 1.72; }
    .signals { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .signal { padding: 26px 28px; border-inline-end: 1px solid var(--line); }
    .signal:last-child { border-inline-end: 0; }
    .signal strong { display: block; color: var(--blue); font-size: 34px; line-height: 1; letter-spacing: -1.5px; }
    .signal span { display: block; margin-top: 9px; color: var(--muted); font-size: 12.5px; line-height: 1.45; }
    .move { margin: 30px 42px 0; padding: 22px 24px; border: 1px solid rgba(29,155,240,.28); border-radius: 15px; background: var(--blue-soft); }
    .move-label { color: var(--blue); font-size: 11px; font-weight: 850; letter-spacing: 1.4px; text-transform: uppercase; }
    html[dir='rtl'] .move-label { letter-spacing: .2px; text-transform: none; }
    .move p { margin-top: 8px; color: #e1e4e6; font-size: 15px; line-height: 1.67; font-weight: 550; }
    .source { padding: 25px 42px 38px; color: #626970; font-size: 12px; line-height: 1.5; }
    .read-issue { display: inline-flex; align-items: center; gap: 8px; margin: 0 42px 36px; color: var(--blue); font-size: 14px; font-weight: 850; }
    .read-issue::after { content: '→'; transition: transform .2s; }
    html[dir='rtl'] .read-issue::after { content: '←'; }
    .latest:hover .read-issue::after { transform: translateX(4px); }
    html[dir='rtl'] .latest:hover .read-issue::after { transform: translateX(-4px); }
    .closing { padding: 84px 0 32px; text-align: center; }
    .closing h2 { max-width: 700px; margin-inline: auto; }
    .closing > p { max-width: 570px; margin: 17px auto 0; color: var(--muted); font-size: 15.5px; line-height: 1.65; }
    .closing .signup-wrap { margin-top: 30px; }
    .reveal { opacity: 0; transform: translateY(18px); animation: reveal .7s cubic-bezier(.2,.8,.2,1) forwards; }
    .hero .reveal:nth-child(2) { animation-delay: .08s; }
    .hero .reveal:nth-child(3) { animation-delay: .16s; }
    .hero .reveal:nth-child(4) { animation-delay: .24s; }
    .hero .reveal:nth-child(5) { animation-delay: .32s; }
    @keyframes reveal { to { opacity: 1; transform: none; } }
    @media (max-width: 680px) {
      .topbar { height: 66px; }
      .nav-link { display: none; }
      .hero { padding: 48px 0; }
      h1 { letter-spacing: -1.2px; text-wrap: balance; }
      html[dir='rtl'] h1 { letter-spacing: -1px; }
      .signup-form { grid-template-columns: 1fr; }
      .signup-form button { width: 100%; }
      .section { padding: 60px 0; }
      .issue-row { grid-template-columns: 46px 1fr; gap: 4px 12px; padding: 17px 18px; }
      .issue-desc { grid-column: 2; }
      .latest-main { padding: 30px 24px 26px; }
      .signals { grid-template-columns: 1fr; }
      .signal { display: grid; grid-template-columns: 76px 1fr; align-items: center; gap: 12px; border-inline-end: 0; border-bottom: 1px solid var(--line); padding: 20px 24px; }
      .signal:last-child { border-bottom: 0; }
      .signal span { margin: 0; }
      .move { margin: 24px 24px 0; }
      .source { padding: 22px 24px 30px; }
      .read-issue { margin: 0 24px 30px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal { opacity: 1; transform: none; animation: none; }
      * { transition-duration: .01ms !important; }
    }
    .editor-note{margin-top:28px;padding:28px;border-inline-start:3px solid var(--blue);background:var(--panel);border-radius:12px;line-height:1.8;color:var(--ink)}
    .editor-note strong{display:block;margin-top:14px;color:var(--muted);font-size:14px}
    .signup-form .application-field{grid-column:1/-1;display:grid;gap:7px;width:100%;text-align:start;color:#c8d2db;font-size:14px;font-weight:600}
    .signup-form .application-field[hidden]{display:none}
    .signup-form .application-field input,.signup-form .application-field select{width:100%;min-width:0;font:inherit;padding:14px;border:1px solid #35444c;border-radius:10px;background:#0c1116;color:#fff;min-height:48px}
  </style>
</head>
<body>
  <div class="site-shell">
    <div class="header-shell"><SiteHeader lang={lang} active="newsletter" /></div>

    <main>
      <div class="confirmation-banner" hidden data-confirmation role="status">{he ? 'כתובת המייל אומתה. הצירוף לרשימת האקזקיוטיבז מחייב גם אישור אישי של יובל ומתעדכן בתוך מספר דקות.' : 'Your email address is verified. Joining the executive list also requires Yuval’s personal approval and is processed within a few minutes.'}</div>
      <section class="hero">
        <div class="eyebrow reveal">{copy.eyebrow}</div>
        <h1 class="reveal">{copy.headlineA}<span>{copy.headlineB}</span></h1>
        <p class="hero-copy reveal">{copy.intro}</p>
        <div class="signup-wrap reveal" id="subscribe">
          <form class="signup-form" data-newsletter-form novalidate>
            <label class="honeypot" aria-hidden="true">Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
            <label class="application-field">{he ? 'שם מלא' : 'Full name'}<input name="fullName" type="text" autocomplete="name" required minlength="2" maxlength="120" /></label>
            <label class="application-field">{he ? 'תפקיד בהנהלה' : 'Executive role'}<input name="jobTitle" type="text" autocomplete="organization-title" required minlength="2" maxlength="120" placeholder={he ? 'למשל: מנכ״ל, סמנכ״לית' : 'e.g. CEO, VP, Managing Director'} /></label>
            <label class="application-field">{he ? 'חברה / ארגון' : 'Company / organization'}<input name="organization" type="text" autocomplete="organization" required minlength="2" maxlength="160" /></label>
            <label class="application-field">{he ? 'שפה מועדפת' : 'Preferred language'}<select name="preferredLanguage" required><option value="">{he ? 'בחירת שפה' : 'Choose a language'}</option><option value="he">{he ? 'עברית' : 'Hebrew'}</option><option value="en">{he ? 'אנגלית' : 'English'}</option><option value="other">{he ? 'אחרת' : 'Other'}</option></select></label>
            <label class="application-field" data-other-language hidden>{he ? 'איזו שפה תעדיפו?' : 'Which language would you prefer?'}<input name="otherLanguage" type="text" maxlength="80" disabled /></label>
            <input name="email" type="email" dir="ltr" inputmode="email" autocomplete="email" required placeholder={copy.email} aria-label={copy.email} />
            <button type="submit" data-idle={copy.cta} data-loading={copy.loading}>{copy.cta}</button>
            <label class="consent"><input name="consent" type="checkbox" required /> <span>{he ? 'אני רוצה לקבל את הניוזלטר של FutureProof במייל.' : 'I would like to receive the FutureProof newsletter by email.'}</span></label>
          </form>
          <p class="form-note">{copy.note}</p>
          <p class="form-status" aria-live="polite" data-success={copy.success} data-error={copy.error}></p>
        </div>
        <div class="proof-row reveal">
          {copy.proof.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <hr class="rule" />

      <section class="section" aria-labelledby="readership-title">
        <div class="section-head">
          <div class="eyebrow">{he ? 'קהל מדויק. רף כניסה ברור.' : 'A focused readership. A clear admission standard.'}</div>
          <h2 id="readership-title">{he ? 'לא לכל מי שמתעניין ב־AI. למי שאחראי למה שעושים איתו.' : 'Not just interested in AI. Accountable for what it delivers.'}</h2>
          <p>{he ? 'הניוזלטר מיועד למנכ״לים, מייסדים שמובילים חברה בפועל וסמנכ״לים עם אחריות על אסטרטגיה, תקציב, צוותים או הטמעה. סקרנות טכנולוגית לבדה אינה תנאי קבלה; האחריות הניהולית והרלוונטיות לתוכן הן מה שקובע.' : 'For CEOs, founders actively running a company, and senior executives responsible for strategy, budgets, teams or implementation. Interest in technology alone is not the admission criterion. Leadership responsibility and relevance to the content are.'}</p>
        </div>
        <div class="issue-grid">
          {(he ? [
            ['01', 'מגישים בקשה', 'שם, תפקיד, חברה ושפה מועדפת — כדי להבין מי נמצא בצד השני.'],
            ['02', 'יובל בודק אישית', 'כל בקשה נבחנת לפי התאמתה לקהל. הגשת הטופס אינה מבטיחה קבלה.'],
            ['03', 'מקבלים אישור ומאמתים', 'אם הבקשה מאושרת, מקבלים קישור לאימות המייל. רק לאחר שני השלבים מצטרפים לרשימה.']
          ] : [
            ['01', 'Apply', 'Share your name, role, company and preferred language so I know who is on the other side.'],
            ['02', 'Yuval reviews personally', 'Every application is considered for fit. Submitting the form does not guarantee admission.'],
            ['03', 'Approval, then verification', 'If approved, you receive an email verification link. You join the list only after both steps.']
          ]).map(([no,name,desc]) => <article class="issue-row"><div class="issue-no">{no}</div><div class="issue-name">{name}</div><p class="issue-desc">{desc}</p></article>)}
        </div>
        <div class="editor-note">
          <p>{he ? 'אני רוצה לכתוב לאנשים שצריכים לקבל החלטות אמיתיות על AI — לא לצבור עוד כתובות ברשימה. לכן אני בודק כל בקשה אישית.' : 'I want to write for people who need to make real decisions about AI — not simply collect more email addresses. That is why I review every application personally.'}</p>
          <strong>{he ? 'יובל קשטכר · FutureProof Agents' : 'Yuval Keshtcher · FutureProof Agents'}</strong>
        </div>
      </section>
      <hr class="rule" />

      <section class="section">
        <div class="section-head">
          <div class="eyebrow">{copy.insideEyebrow}</div>
          <h2>{copy.insideTitle}</h2>
          <p>{copy.insideIntro}</p>
        </div>
        <div class="issue-grid">
          {copy.sections.map(([no, name, desc]) => (
            <article class="issue-row">
              <div class="issue-no">{no}</div>
              <div class="issue-name">{name}</div>
              <p class="issue-desc">{desc}</p>
            </article>
          ))}
        </div>
      </section>

      <hr class="rule" />

      <section class="section" id="latest">
        <a class="latest" href={issuePath} aria-label={`${copy.readIssue}: ${copy.latestTitle}`}>
          <div class="latest-main">
            <div class="eyebrow">{copy.latestEyebrow}</div>
            <h2>{copy.latestTitle}</h2>
            <p class="latest-dek">{copy.latestDek}</p>
          </div>
          <div class="signals" aria-label={copy.signalsTitle}>
            {copy.signals.map(([value, label]) => (
              <div class="signal"><strong>{value}</strong><span>{label}</span></div>
            ))}
          </div>
          <div class="move">
            <div class="move-label">{copy.moveLabel}</div>
            <p>{copy.move}</p>
          </div>
          <p class="source">{copy.source}</p>
          <span class="read-issue">{copy.readIssue}</span>
        </a>
      </section>

      <hr class="rule" />

      <section class="closing">
        <div class="eyebrow">{copy.closingEyebrow}</div>
        <h2>{copy.closingTitle}</h2>
        <p>{copy.closingText}</p>
        <div class="signup-wrap">
          <form class="signup-form" data-newsletter-form novalidate>
            <label class="honeypot" aria-hidden="true">Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
            <label class="application-field">{he ? 'שם מלא' : 'Full name'}<input name="fullName" type="text" autocomplete="name" required minlength="2" maxlength="120" /></label>
            <label class="application-field">{he ? 'תפקיד בהנהלה' : 'Executive role'}<input name="jobTitle" type="text" autocomplete="organization-title" required minlength="2" maxlength="120" placeholder={he ? 'למשל: מנכ״ל, סמנכ״לית' : 'e.g. CEO, VP, Managing Director'} /></label>
            <label class="application-field">{he ? 'חברה / ארגון' : 'Company / organization'}<input name="organization" type="text" autocomplete="organization" required minlength="2" maxlength="160" /></label>
            <label class="application-field">{he ? 'שפה מועדפת' : 'Preferred language'}<select name="preferredLanguage" required><option value="">{he ? 'בחירת שפה' : 'Choose a language'}</option><option value="he">{he ? 'עברית' : 'Hebrew'}</option><option value="en">{he ? 'אנגלית' : 'English'}</option><option value="other">{he ? 'אחרת' : 'Other'}</option></select></label>
            <label class="application-field" data-other-language hidden>{he ? 'איזו שפה תעדיפו?' : 'Which language would you prefer?'}<input name="otherLanguage" type="text" maxlength="80" disabled /></label>
            <input name="email" type="email" dir="ltr" inputmode="email" autocomplete="email" required placeholder={copy.email} aria-label={copy.email} />
            <button type="submit" data-idle={copy.cta} data-loading={copy.loading}>{copy.cta}</button>
            <label class="consent"><input name="consent" type="checkbox" required /> <span>{he ? 'אני רוצה לקבל את הניוזלטר של FutureProof במייל.' : 'I would like to receive the FutureProof newsletter by email.'}</span></label>
          </form>
          <p class="form-note">{copy.note}</p>
          <p class="form-status" aria-live="polite" data-success={copy.success} data-error={copy.error}></p>
        </div>
      </section>
    </main>

    <SiteFooter lang={lang} />
  </div>

  <script is:inline define:vars={{ lang }}>
    (function () {
      if (new URLSearchParams(location.search).get('confirmed') === '1') document.querySelector('[data-confirmation]').hidden = false;
      var localHost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      var isVercel = location.hostname.endsWith('.vercel.app');
      var endpoint = (localHost || isVercel)
        ? '/api/newsletter'
        : 'https://yuvalkesh-links.vercel.app/api/newsletter';

      document.querySelectorAll('[data-newsletter-form]').forEach(function (form) {
        var languageSelect = form.querySelector('[name=preferredLanguage]');
        var otherField = form.querySelector('[data-other-language]');
        var otherInput = form.querySelector('[name=otherLanguage]');
        languageSelect.addEventListener('change', function () {
          var other = languageSelect.value === 'other';
          otherField.hidden = !other;
          otherInput.disabled = !other;
          otherInput.required = other;
        });
        form.addEventListener('submit', async function (event) {
          event.preventDefault();
          var emailInput = form.querySelector('input[name="email"]');
          var companyInput = form.querySelector('input[name="company"]');
          var button = form.querySelector('button[type="submit"]');
          var status = form.parentElement.querySelector('.form-status');
          var email = emailInput.value.trim();

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          button.disabled = true;
          button.textContent = button.dataset.loading;
          status.textContent = '';
          status.removeAttribute('data-state');

          try {
            var response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: email,
                fullName: form.querySelector('[name=fullName]').value.trim(),
                jobTitle: form.querySelector('[name=jobTitle]').value.trim(),
                organization: form.querySelector('[name=organization]').value.trim(),
                preferredLanguage: languageSelect.value,
                otherLanguage: languageSelect.value === 'other' ? otherInput.value.trim() : '',
                consent: form.querySelector('[name="consent"]').checked,
                company: companyInput.value,
                lang: lang,
                page: location.href,
              }),
            });

            var result = await response.json();
            if (!response.ok || result.status !== 'pending_review') throw new Error('signup failed');
            emailInput.value = '';
            status.textContent = status.dataset.success;
            status.dataset.state = 'success';
            window.fpAnalytics?.('newsletter_signup');
            button.textContent = button.dataset.idle;
          } catch (error) {
            status.textContent = status.dataset.error;
            status.dataset.state = 'error';
            button.textContent = button.dataset.idle;
          } finally {
            button.disabled = false;
          }
        });
      });
    })();
  </script>
</body>
</html>
