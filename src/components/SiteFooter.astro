---
import NewsletterInvite from './NewsletterInvite.astro';
interface Props {
  lang?: 'he' | 'en';
}
const { lang = 'en' } = Astro.props;
const he = lang === 'he';

const nav = he
  ? [
      { href: '/he/', label: 'ראשי' },
      { href: '/he/newsletter/', label: 'ניוזלטר' },
      { href: '/he/blog/', label: 'מאמרים' },
      { href: '/he/links/', label: 'כל הלינקים' },
      { href: '/', label: 'English' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/newsletter/', label: 'Newsletter' },
      { href: '/blog/', label: 'Articles' },
      { href: '/prompts/', label: 'Prompt Playbook' },
      { href: '/he/', label: 'עברית' },
    ];

const social = he
  ? [
      { href: 'https://chat.whatsapp.com/KjeF05QrMTZ0s5ty66Ee92', label: 'קבוצת הוואטסאפ' },
      { href: 'https://www.facebook.com/groups/agentil', label: 'קהילת הפייסבוק' },
      { href: 'https://x.com/Parzival_1991', label: 'טוויטר / X' },
      { href: 'https://www.youtube.com/@theLOOP-tube', label: 'theLOOP ביוטיוב' },
    ]
  : [
      { href: 'https://chat.whatsapp.com/KjeF05QrMTZ0s5ty66Ee92', label: 'WhatsApp community' },
      { href: 'https://www.facebook.com/groups/agentil', label: 'Facebook community' },
      { href: 'https://x.com/Parzival_1991', label: 'X / Twitter' },
      { href: 'https://www.youtube.com/@theLOOP-tube', label: 'theLOOP on YouTube' },
    ];
---
<NewsletterInvite lang={lang} />
<footer class="site-footer" dir={he ? 'rtl' : 'ltr'} lang={lang}>
  <nav class="row" aria-label={he ? 'ניווט באתר' : 'Site navigation'}>
    {nav.map((l, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <a href={l.href}>{l.label}</a>
      </>
    ))}
  </nav>
  <nav class="row" aria-label={he ? 'קהילות' : 'Communities'}>
    {social.map((l, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
      </>
    ))}
  </nav>
</footer>

<style>
  .site-footer {
    width:100%;max-width:1116px;box-sizing:border-box;
    margin: 56px auto 0;
    padding: 22px 18px 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    text-align: center;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 8px;
  }
  .row:last-child { margin-bottom: 0; }
  .site-footer a {
    color: #a4aeb8;
    text-decoration: none;
    font-size: 13px;min-height:44px;display:inline-flex;align-items:center;
    font-weight: 500;
    line-height: 1.8;
    transition: color 0.15s ease;
  }
  .site-footer a:hover { color: #e7e9ea; }
  .sep {
    color: #3a3d40;
    font-size: 12px;
    user-select: none;
  }
</style>
