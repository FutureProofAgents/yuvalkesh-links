---
import SiteHeader from './SiteHeader.astro';
interface Props { lang: 'he' | 'en'; active?: 'home' | 'blog' | 'newsletter'; alternatePath?: string; }
---
<div class="fp-page-header"><SiteHeader {...Astro.props} /></div>
<style>
.fp-page-header{width:100%;max-width:1116px;position:relative;z-index:2;margin:0 auto 48px;flex:none}
:global(body.fp-site-page){display:flex;flex-direction:column;align-items:center;justify-content:flex-start;height:auto;min-height:100vh;padding:0 32px 64px;overflow-x:clip;background-color:#000;background-image:radial-gradient(ellipse 700px 400px at 50% 0,rgba(29,155,240,.09),transparent 75%)}
:global(.fp-site-page > main),:global(.fp-site-page > article){flex:none;min-width:0}
:global(.fp-site-page a:focus-visible),:global(.fp-site-page button:focus-visible){outline:3px solid #61baff;outline-offset:4px}
@media(max-width:700px){:global(body.fp-site-page){padding:0 20px 48px}.fp-page-header{margin-bottom:32px}}
@media(prefers-reduced-motion:reduce){:global(.fp-site-page *){scroll-behavior:auto!important;animation:none!important;transition:none!important}:global(.fp-site-page .fade){opacity:1;transform:none}}
</style>
