---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  lang: 'he' | 'en';
  tags: string[];
  ogImage?: string;
  coverImage?: { src: string; alt: string };
  canonical?: string;
  translationOf?: string;
  slug: string;
  headings?: Heading[];
  faq?: { q: string; a: string }[];
  stickyCta?: { href: string; label: string; eyebrow?: string };
  morePosts?: { slug: string; title: string; description: string; lang: 'he' | 'en'; pubDate: Date }[];
}

const { title, description, pubDate, updatedDate, lang, tags, ogImage, coverImage, canonical, translationOf, slug, headings = [], faq = [], stickyCta, morePosts = [] } = Astro.props;

const dir = lang === 'he' ? 'rtl' : 'ltr';
const site = Astro.site!.href.replace(/\/$/, '');
const pageUrl = `${site}${lang === 'he' ? '/he' : ''}/blog/${slug}/`;
const canonicalUrl = canonical ?? pageUrl;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : coverImage
    ? new URL(coverImage.src, Astro.site).href
    : `${site}/avatar.jpg`;
const otherLang = lang === 'he' ? 'en' : 'he';
const backLabel = lang === 'he' ? 'לכל המאמרים →' : '← All articles';
const tocLabel = lang === 'he' ? 'תוכן עניינים' : 'Table of Contents';
const followLabel = lang === 'he' ? 'בואו נמשיך לדבר' : "Let's keep talking";
const followSub = lang === 'he'
  ? 'אלפי בונים כבר בפנים. שאלות, פרויקטים, ומה שעובד באמת.'
  : 'Thousands of builders are already inside. Questions, builds, and what actually works.';
const moreLabel = lang === 'he' ? 'עוד מאמרים' : 'More articles';
const dateLocale = lang === 'he' ? 'he-IL' : 'en-US';
const fmt = (d: Date) => d.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });

const tocHeadings = headings.filter((h) => h.depth === 2);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: ogImageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: {
    '@type': 'Person',
    name: 'Yuval Keshtcher',
    url: site,
    sameAs: [
      'https://x.com/Parzival_1991',
      'https://www.facebook.com/groups/agentil',
      'https://github.com/Yuvalkesh',
    ],
  },
  publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'FutureProof Agents', url: site, logo: { '@type': 'ImageObject', url: `${site}/favicon-96.png` } },
};

const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'yuvkesh', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const socials = [
  {
    href: 'https://wa.me/+972526414555',
    label: lang === 'he' ? 'דברו איתי בוואטסאפ' : 'Message me on WhatsApp',
    cls: 'ico-whatsapp',
    path: 'M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z',
  },
  {
    href: 'https://chat.whatsapp.com/KjeF05QrMTZ0s5ty66Ee92',
    label: lang === 'he' ? 'קבוצת הוואטסאפ' : 'WhatsApp community',
    cls: 'ico-whatsapp',
    path: 'M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z',
  },
  {
    href: 'https://www.facebook.com/groups/agentil',
    label: lang === 'he' ? 'קהילת הפייסבוק' : 'Facebook community',
    cls: 'ico-facebook',
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    href: 'https://x.com/Parzival_1991',
    label: lang === 'he' ? 'טוויטר / X' : 'Twitter / X',
    cls: 'ico-twitter',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
];
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <script is:inline defer src="/scripts/analytics.js"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | FutureProof Agents</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="yuvkesh" href={`${site}/rss.xml`} />
  {translationOf && (
    <>
      <link rel="alternate" hreflang={lang} href={pageUrl} />
      <link rel="alternate" hreflang={otherLang} href={`${site}${otherLang === 'he' ? '/he' : ''}/blog/${translationOf}/`} />
      <link rel="alternate" hreflang="x-default" href={lang === 'en' ? pageUrl : `${site}${otherLang === 'he' ? '/he' : ''}/blog/${translationOf}/`} />
    </>
  )}

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />
  <meta property="article:published_time" content={pubDate.toISOString()} />
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  {tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:creator" content="@Parzival_1991" />
  <meta name="theme-color" content="#000000" />

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root { --x-blue: #1d9bf0; --line: #2f3336; --muted: #71767b; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #000;
      color: #e7e9ea;
      min-height: 100vh;
      padding: 48px 18px 64px;
      display: flex;
      justify-content: center;
    }
    .wrap { width: 100%; max-width: 680px; }
    .top-nav {
      margin-bottom: 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      min-height: 28px;
    }
    .top-nav a {
      color: var(--x-blue);
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
    }
    .top-nav a:hover { text-decoration: underline; }
    .lang-switch {
      display: inline-flex;
      align-items: center;
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 999px;
      overflow: hidden;
      flex-shrink: 0;
    }
    .lang-opt {
      padding: 4px 13px;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.4;
      color: var(--muted);
      text-decoration: none;
      white-space: nowrap;
    }
    .lang-opt.active {
      background: var(--x-blue);
      color: #fff;
    }
    .top-nav a.lang-opt { color: var(--muted); font-size: 13px; }
    .top-nav a.lang-opt:hover {
      text-decoration: none;
      color: #e7e9ea;
      background: #1d1f23;
    }
    h1 {
      font-size: 34px;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 14px;
    }
    .meta {
      color: var(--muted);
      font-size: 14.5px;
      margin-bottom: 8px;
    }
    .tags { margin-bottom: 28px; display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      font-size: 12.5px;
      color: var(--x-blue);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 3px 12px;
    }
    .cover {
      width: 100%;
      height: auto;
      border-radius: 18px;
      border: 1px solid var(--line);
      margin-bottom: 32px;
      display: block;
    }
    .toc {
      background: #0a0c0e;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px 26px;
      margin-bottom: 36px;
    }
    .toc-title {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }
    .toc ol { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .toc a {
      color: #d6d9db;
      text-decoration: none;
      font-size: 15.5px;
      font-weight: 500;
    }
    .toc a:hover { color: var(--x-blue); }
    .toc a::before { content: '#'; color: var(--x-blue); margin-inline-end: 8px; font-weight: 700; }
    .divider { border: none; border-top: 1px solid var(--line); margin-bottom: 36px; }
    .sticky-cta {
      position: sticky; top: 10px; z-index: 20;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      margin: 0 0 30px; padding: 11px 12px 11px 18px;
      border: 1px solid rgba(29,155,240,0.5); border-radius: 16px;
      background: rgba(10,12,14,0.94); box-shadow: 0 12px 36px rgba(0,0,0,0.55);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    .sticky-cta-copy { min-width: 0; }
    .sticky-cta-eyebrow { color: #8b98a5; font-size: 12px; line-height: 1.2; margin-bottom: 2px; }
    .sticky-cta-title { color: #e7e9ea; font-size: 14px; font-weight: 800; line-height: 1.35; }
    .sticky-cta-button {
      flex: none; padding: 9px 17px; border-radius: 999px;
      background: var(--x-blue); color: #fff; text-decoration: none;
      font-size: 13.5px; font-weight: 800; white-space: nowrap;
      transition: transform .2s ease, background .2s ease;
    }
    .sticky-cta-button:hover { background: #1a8cd8; transform: translateY(-1px); }
    .content { font-size: 17.5px; line-height: 1.85; color: #d6d9db; }
    .content :global(h2) {
      font-size: 25px; font-weight: 800; color: #e7e9ea;
      margin: 52px 0 20px; line-height: 1.3;
      scroll-margin-top: 24px;
    }
    .content :global(h3) {
      font-size: 20px; font-weight: 700; color: #e7e9ea;
      margin: 40px 0 14px;
      scroll-margin-top: 24px;
    }
    .content :global(p) { margin-bottom: 26px; }
    .content :global(a) { color: var(--x-blue); text-decoration: none; }
    .content :global(a:hover) { text-decoration: underline; }
    .content :global(ul), .content :global(ol) { margin: 0 0 26px; padding-inline-start: 26px; }
    .content :global(li) { margin-bottom: 12px; }
    .content :global(blockquote) {
      position: relative;
      border: 1px solid rgba(29,155,240,0.3);
      border-inline-start: 4px solid var(--x-blue);
      border-radius: 14px;
      padding: 18px 20px;
      color: #d6d9db;
      background: linear-gradient(135deg, rgba(29,155,240,0.10), rgba(22,24,28,0.72));
      margin: 8px 0 30px;
    }
    .content :global(blockquote p:last-child) { margin-bottom: 0; }
    .content :global(strong) { color: #f2f4f5; font-weight: 800; }
    .content :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 48px 0; }
    .content :global(code) {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 1px 7px;
      font-size: 15px;
    }
    .content :global(pre) {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px;
      overflow-x: auto;
      margin-bottom: 26px;
      direction: ltr;
      text-align: left;
    }
    .content :global(pre code) { background: none; border: none; padding: 0; }
    .content :global(img) {
      max-width: 100%;
      border-radius: 16px;
      border: 1px solid var(--line);
      margin: 8px 0 10px;
      display: block;
    }
    .content :global(em) { color: #b8bcbf; }
    .content :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      margin: 8px 0 30px;
      font-size: 15px;
      line-height: 1.5;
    }
    .content :global(th), .content :global(td) {
      border: 1px solid var(--line);
      padding: 10px 12px;
      text-align: start;
      vertical-align: top;
      min-width: 110px;
      unicode-bidi: plaintext;
    }
    .content :global(th) {
      background: #16181c;
      color: #f2f4f5;
      font-weight: 800;
      white-space: nowrap;
    }
    .content :global(tr:nth-child(even) td) { background: rgba(255,255,255,0.02); }
    .author {
      margin-top: 56px;
      border-top: 1px solid var(--line);
      padding-top: 26px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .author img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
    .author .a-name { font-weight: 800; font-size: 15.5px; }
    .author .a-sub { color: var(--muted); font-size: 13.5px; }
    .author a { color: inherit; text-decoration: none; }
    .follow {
      margin-top: 32px;
      background: radial-gradient(ellipse 480px 260px at 50% -60px, rgba(29,155,240,0.14), transparent 70%), #0a0c0e;
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 34px 28px 30px;
      text-align: center;
    }
    .follow-title { font-size: 21px; font-weight: 800; margin-bottom: 6px; }
    .follow-sub { color: var(--muted); font-size: 14.5px; margin-bottom: 22px; line-height: 1.55; }
    .follow-links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .follow-link {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 20px 10px 12px;
      background: #16181c; color: #e7e9ea;
      border: 1px solid var(--line); border-radius: 999px;
      text-decoration: none; font-size: 14.5px; font-weight: 700;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .follow-link:hover {
      transform: translateY(-2px);
      background: #1d1f23;
      border-color: #3d4044;
      box-shadow: 0 8px 22px rgba(0,0,0,0.5);
    }
    .follow-link .ico {
      width: 30px; height: 30px; border-radius: 50%;
      display: grid; place-items: center; flex: none;
    }
    .follow-link .ico svg { width: 16px; height: 16px; fill: #fff; }
    .ico-whatsapp { background: #25d366; }
    .ico-facebook { background: #1877f2; }
    .ico-twitter { background: #fff; }
    .ico-twitter svg { fill: #000; }
    .more { margin-top: 44px; }
    .more-title {
      font-size: 14px; font-weight: 800; letter-spacing: 0.6px;
      text-transform: uppercase; color: var(--muted); margin-bottom: 16px;
    }
    .more-list { display: flex; flex-direction: column; gap: 14px; }
    .more-card {
      display: block;
      background: #0a0c0e;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px 22px;
      text-decoration: none;
      color: #e7e9ea;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .more-card:hover { transform: translateY(-2px); background: #16181c; border-color: #3d4044; }
    .more-card h3 { font-size: 16.5px; font-weight: 800; line-height: 1.4; margin-bottom: 5px; }
    .more-card p { color: #9ca1a5; font-size: 13.5px; line-height: 1.55; margin-bottom: 8px; }
    .more-card .row { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 12px; }
    .more-card .badge {
      font-size: 10.5px; font-weight: 700; color: var(--x-blue);
      border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px;
    }
    @media (max-width: 480px) {
      body { padding: 32px 16px 72px; overflow-x: hidden; }
      .wrap { width: 100%; max-width: calc(100vw - 32px); min-width: 0; overflow-wrap: anywhere; }
      .top-nav { margin-bottom: 28px; }
      h1 { font-size: 27px; }
      .content { font-size: 16.5px; }
      .content :global(h2) { font-size: 23px; margin-top: 44px; }
      .content :global(h3) { font-size: 19px; margin-top: 34px; }
      .content :global(p) { margin-bottom: 22px; }
      .content :global(blockquote) { padding: 15px 16px; margin-bottom: 24px; }
      .content :global(pre) { margin-inline: -6px; border-radius: 10px; font-size: 13px; }
      .toc { padding: 18px 17px; }
      .follow-links { flex-direction: column; align-items: stretch; }
      .follow-link { justify-content: center; }
      .sticky-cta { top: 6px; gap: 10px; padding: 9px 9px 9px 12px; border-radius: 14px; }
      .sticky-cta-eyebrow { display: none; }
      .sticky-cta-title { font-size: 12.5px; }
      .sticky-cta-button { padding: 8px 13px; font-size: 12.5px; }
    }
  </style>
</head>
<body>
  <article class="wrap">
    <nav class="top-nav">
      <a href={lang === 'he' ? '/he/blog/' : '/blog/'}>{backLabel}</a>
      {translationOf && (
        <div class="lang-switch" dir="ltr" role="navigation" aria-label={lang === 'he' ? 'שפה' : 'Language'}>
          {lang === 'en' ? (
            <span class="lang-opt active" aria-current="true">EN</span>
          ) : (
            <a class="lang-opt" href={`/blog/${translationOf}/`} lang="en" title="Read in English">EN</a>
          )}
          {lang === 'he' ? (
            <span class="lang-opt active" aria-current="true">עב</span>
          ) : (
            <a class="lang-opt" href={`/he/blog/${translationOf}/`} lang="he" title="קראו בעברית">עב</a>
          )}
        </div>
      )}
    </nav>
    <h1>{title}</h1>
    <p class="meta">
      {fmt(pubDate)}{updatedDate && ` · ${lang === 'he' ? 'עודכן' : 'Updated'} ${fmt(updatedDate)}`}
    </p>
    {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
    {coverImage && <img class="cover" src={coverImage.src} alt={coverImage.alt} width="1400" height="700" fetchpriority="high" />}
    {tocHeadings.length > 1 && (
      <nav class="toc" aria-label={tocLabel}>
        <div class="toc-title">{tocLabel}</div>
        <ol>
          {tocHeadings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <hr class="divider" />
    {stickyCta && (
      <aside class="sticky-cta" aria-label={stickyCta.eyebrow ?? stickyCta.label}>
        <div class="sticky-cta-copy">
          {stickyCta.eyebrow && <div class="sticky-cta-eyebrow">{stickyCta.eyebrow}</div>}
          <div class="sticky-cta-title">{lang === 'he' ? 'רוצים לבנות צוות סוכנים כזה?' : 'Want to build an agent team like this?'}</div>
        </div>
        <a class="sticky-cta-button" href={stickyCta.href} target="_blank" rel="sponsored noopener noreferrer">{stickyCta.label}</a>
      </aside>
    )}
    <div class="content">
      <slot />
    </div>
    <footer class="author">
      <a href="/"><img src="/avatar.jpg" alt="יובל קשטכר" /></a>
      <div>
        <div class="a-name"><a href="/">{lang === 'he' ? 'יובל קשטכר' : 'Yuval Keshtcher'}</a></div>
        <div class="a-sub">{lang === 'he' ? 'בינה מלאכותית עסקית עם יובל קשטכר' : 'Building AI agents. Teaching people to build.'}</div>
      </div>
    </footer>
    <section class="follow">
      <div class="follow-title">{followLabel}</div>
      <p class="follow-sub">{followSub}</p>
      <div class="follow-links">
        {socials.map((s) => (
          <a class="follow-link" href={s.href} target="_blank" rel="noopener noreferrer">
            <span class={`ico ${s.cls}`} aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d={s.path} /></svg>
            </span>
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </section>
    {morePosts.length > 0 && (
      <section class="more">
        <div class="more-title">{moreLabel}</div>
        <div class="more-list">
          {morePosts.map((p) => (
            <a class="more-card" href={`${p.lang === 'he' ? '/he' : ''}/blog/${p.slug}/`} dir={p.lang === 'he' ? 'rtl' : 'ltr'} lang={p.lang}>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <div class="row">
                <span class="badge">{p.lang === 'he' ? 'עברית' : 'EN'}</span>
                <time datetime={p.pubDate.toISOString()}>{p.pubDate.toLocaleDateString(p.lang === 'he' ? 'he-IL' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</body>
</html>
